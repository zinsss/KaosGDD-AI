#!/usr/bin/env bash
set -euo pipefail

DEPLOY_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${DEPLOY_DIR}/../.." && pwd)
KAOSGDD_ROOT=${KAOSGDD_ROOT:-/srv/kaosgdd}
LEGACY_ROOT=${KAOSBRAIN_LEGACY_ROOT:-/srv/kaos}
CANONICAL_ENV_DIR=${KAOSGDD_ROOT}/kaosbrain
CANONICAL_SECRETS_DIR=${KAOSGDD_ROOT}/secrets
if [[ -z "${KAOSBRAIN_ENV_DIR:-}" && -f "${LEGACY_ROOT}/brain/kaosbrain.env" && ! -f "${CANONICAL_ENV_DIR}/kaosbrain.env" ]]; then
  ENV_DIR=${LEGACY_ROOT}/brain
else
  ENV_DIR=${KAOSBRAIN_ENV_DIR:-${CANONICAL_ENV_DIR}}
fi
ENV_FILE=${KAOSBRAIN_ENV_FILE:-${ENV_DIR}/kaosbrain.env}
if [[ -z "${KAOSBRAIN_SECRETS_DIR:-}" && -f "${LEGACY_ROOT}/secrets/kaosbrain_discord_bot_token" && ! -f "${CANONICAL_SECRETS_DIR}/kaosbrain_discord_bot_token" ]]; then
  SECRETS_DIR=${LEGACY_ROOT}/secrets
else
  SECRETS_DIR=${KAOSBRAIN_SECRETS_DIR:-${CANONICAL_SECRETS_DIR}}
fi
TOKEN_FILE=${KAOSBRAIN_TOKEN_FILE:-${SECRETS_DIR}/kaosbrain_discord_bot_token}
GOVERNOR_TOKEN_FILE=${KAOSBRAIN_GOVERNOR_TOKEN_FILE:-${SECRETS_DIR}/governor_api_token}
SERVICE_NAME=${KAOSBRAIN_SERVICE_NAME:-kaosbrain.service}
IMAGE_NAME=${KAOSBRAIN_IMAGE_NAME:-kaos-brain:current}
CONTAINER_NAME=${KAOSBRAIN_CONTAINER_NAME:-kaos-brain}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

load_env() {
  [[ -f "${ENV_FILE}" ]] || die "missing env file: ${ENV_FILE}; run ${0} setup"
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
}

host_secret_path() {
  local path=$1
  if [[ "${path}" == /run/secrets/* ]]; then
    printf '%s/%s' "${SECRETS_DIR}" "${path##*/}"
    return
  fi
  printf '%s' "${path}"
}

sed_escape() {
  printf '%s' "$1" | sed -e 's/[\/&]/\\&/g'
}

set_env_value() {
  local key=$1
  local value=$2
  local escaped_value
  escaped_value=$(sed_escape "${value}")
  if grep -q "^${key}=" "${ENV_FILE}"; then
    sed -i "s/^${key}=.*/${key}=${escaped_value}/" "${ENV_FILE}"
  else
    printf '%s=%s\n' "${key}" "${value}" >>"${ENV_FILE}"
  fi
}

validate_internal_http_url() {
  local name=$1
  local url=$2
  local allow_path=${3:-false}
  [[ "${url}" == http://* ]] || die "${name} must be an internal http URL"
  local rest=${url#http://}
  [[ "${rest}" != *"@"* ]] || die "${name} must not include credentials"
  local hostport=${rest%%/*}
  [[ -n "${hostport}" ]] || die "${name} must include a host"
  local path=""
  if [[ "${rest}" == */* ]]; then
    path="/${rest#*/}"
  fi
  if [[ "${allow_path}" != "true" && -n "${path}" && "${path}" != "/" ]]; then
    die "${name} must be a base URL without path"
  fi
  [[ "${url}" != *"?"* && "${url}" != *"#"* ]] || die "${name} must not include query or fragment"

  local host=${hostport}
  if [[ "${host}" == \[*\]* ]]; then
    host=${host#\[}
    host=${host%%\]*}
  else
    host=${host%%:*}
  fi
  host=${host%.}
  case "${host}" in
    kaosgdd.net|*.kaosgdd.net)
      die "${name} must not point at a public KaosGDD route"
      ;;
  esac
}

install_service_unit() {
  local unit_path="/etc/systemd/system/${SERVICE_NAME}"
  sudo sed \
    -e "s/__KAOSBRAIN_TOKEN_FILE__/$(sed_escape "${TOKEN_FILE}")/g" \
    -e "s/__KAOSBRAIN_ENV_FILE__/$(sed_escape "${ENV_FILE}")/g" \
    -e "s/__KAOSBRAIN_SECRETS_DIR__/$(sed_escape "${SECRETS_DIR}")/g" \
    -e "s/__KAOSBRAIN_IMAGE_NAME__/$(sed_escape "${IMAGE_NAME}")/g" \
    -e "s/__KAOSBRAIN_CONTAINER_NAME__/$(sed_escape "${CONTAINER_NAME}")/g" \
    "${DEPLOY_DIR}/kaosbrain.service" | sudo tee "${unit_path}" >/dev/null
}

setup() {
  require_command docker
  require_command sudo
  sudo install -d -m 0750 -o "$USER" -g "$(id -gn)" "${ENV_DIR}" "${SECRETS_DIR}"
  if [[ ! -f "${ENV_FILE}" ]]; then
    cp "${DEPLOY_DIR}/.env.example" "${ENV_FILE}"
    sed -i "s/^KAOS_HOST_UID=.*/KAOS_HOST_UID=$(id -u)/" "${ENV_FILE}"
    sed -i "s/^KAOS_HOST_GID=.*/KAOS_HOST_GID=$(id -g)/" "${ENV_FILE}"
    info "Created ${ENV_FILE}"
  fi
  if [[ ! -e "${TOKEN_FILE}" ]]; then
    : > "${TOKEN_FILE}"
  fi
  if [[ ! -e "${GOVERNOR_TOKEN_FILE}" ]]; then
    : > "${GOVERNOR_TOKEN_FILE}"
  fi
  chmod 0640 "${TOKEN_FILE}"
  chmod 0640 "${GOVERNOR_TOKEN_FILE}"
  install_service_unit
  sudo systemctl daemon-reload
  sudo systemctl enable "${SERVICE_NAME}" >/dev/null
  info "Setup complete. Fill ${ENV_FILE} and ${TOKEN_FILE}, then run:"
  info "  ${0} test"
  info "  ${0} up"
}

preflight() {
  require_command docker
  require_command curl
  require_command sudo
  load_env
  [[ -s "${TOKEN_FILE}" ]] || die "missing or empty token file: ${TOKEN_FILE}"
  [[ "${DISCORD_GUILD_ID:-}" != "123456789012345678" ]] || die "replace the example Discord guild ID"
  [[ "${DISCORD_BRAIN_CHANNEL_ID:-}" != "123456789012345678" ]] || die "replace the example Discord brain channel ID"
  [[ "${DISCORD_ALLOWED_USER_IDS:-}" != *"123456789012345678"* ]] || die "replace the example Discord user ID"
  if [[ "${KAOSBRAIN_GOVERNOR_TOOLS_ENABLED:-false}" == "true" ]]; then
    [[ -n "${KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL:-}" ]] || die "KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL is required"
    validate_internal_http_url "KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL" "${KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL}"
    if [[ -z "${GOVERNOR_API_TOKEN:-}" ]]; then
      local governor_token_path
      governor_token_path=$(host_secret_path "${GOVERNOR_API_TOKEN_FILE:-/run/secrets/governor_api_token}")
      [[ -s "${governor_token_path}" ]] || die "missing or empty Governor token file: ${governor_token_path}"
    fi
  fi
  if [[ -n "${KAOSBRAIN_GOVERNOR_HEALTH_URL:-}" ]]; then
    validate_internal_http_url "KAOSBRAIN_GOVERNOR_HEALTH_URL" "${KAOSBRAIN_GOVERNOR_HEALTH_URL}" true
  fi
  if [[ "${KAOSBRAIN_IMAGING_ENABLED:-false}" == "true" ]]; then
    case "${KAOSBRAIN_IMAGING_PROVIDER:-ollama}" in
      ollama|kaosai) ;;
      *) die "KAOSBRAIN_IMAGING_PROVIDER must be ollama or kaosai" ;;
    esac
    if [[ -z "${KAOSBRAIN_IMAGING_API_TOKEN:-}" ]]; then
      local imaging_token_path
      imaging_token_path=$(host_secret_path "${KAOSBRAIN_IMAGING_API_TOKEN_FILE:-/run/secrets/governor_api_token}")
      [[ -s "${imaging_token_path}" ]] || die "missing or empty KaosBrain imaging token file: ${imaging_token_path}"
    fi
    if [[ "${KAOSBRAIN_IMAGING_PROVIDER:-ollama}" == "kaosai" && "${KAOSAI_ENABLED:-false}" != "true" ]]; then
      die "KAOSAI_ENABLED=true is required when KAOSBRAIN_IMAGING_PROVIDER=kaosai"
    fi
  fi
  if [[ "${KAOSAI_ENABLED:-false}" == "true" ]]; then
    [[ "${KAOSAI_PROVIDER:-}" == "openclaw" ]] || die "KAOSAI_PROVIDER must be openclaw when KAOSAI_ENABLED=true"
    [[ -n "${KAOSAI_BASE_URL:-}" ]] || die "KAOSAI_BASE_URL is required when KAOSAI_ENABLED=true"
    if [[ -z "${KAOSAI_API_TOKEN:-}" && -z "${KAOSAI_API_TOKEN_FILE:-}" ]]; then
      die "KAOSAI_API_TOKEN or KAOSAI_API_TOKEN_FILE is required when KAOSAI_ENABLED=true"
    fi
    if [[ -z "${KAOSAI_API_TOKEN:-}" && -n "${KAOSAI_API_TOKEN_FILE:-}" ]]; then
      local kaosai_token_path
      kaosai_token_path=$(host_secret_path "${KAOSAI_API_TOKEN_FILE}")
      [[ -s "${kaosai_token_path}" ]] || die "missing or empty KaosAI token file: ${kaosai_token_path}"
    fi
  fi
  if [[ "${KAOSAI_DRY_RUN_ENABLED:-false}" == "true" && "${KAOSAI_ENABLED:-false}" != "true" ]]; then
    die "KAOSAI_ENABLED=true is required when KAOSAI_DRY_RUN_ENABLED=true"
  fi
  curl --fail --silent --show-error "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}/api/tags" >/dev/null \
    || die "Ollama is not reachable"
  info "Preflight passed."
}

test_image() {
  require_command docker
  docker build --target test \
    --tag kaosgdd-ai-brain:test \
    --file "${REPO_ROOT}/apps/brain/Dockerfile" \
    "${REPO_ROOT}"
  docker run --rm kaosgdd-ai-brain:test
}

build_image() {
  require_command docker
  docker build --target runtime \
    --tag "${IMAGE_NAME}" \
    --file "${REPO_ROOT}/apps/brain/Dockerfile" \
    "${REPO_ROOT}"
}

smoke() {
  local attempt
  for attempt in $(seq 1 20); do
    if docker ps --filter "name=${CONTAINER_NAME}" --filter "status=running" --format '{{.Names}}' | grep -qx "${CONTAINER_NAME}"; then
      docker logs --since 30s "${CONTAINER_NAME}" 2>&1 | tail -40
      return
    fi
    sleep 1
  done
  sudo systemctl status "${SERVICE_NAME}" --no-pager >&2 || true
  docker logs --tail 80 "${CONTAINER_NAME}" >&2 || true
  die "KaosBrain container did not become running"
}

check_line() {
  local label=$1
  local state=$2
  local detail=${3:-}
  if [[ -n "${detail}" ]]; then
    printf '%-34s %s (%s)\n' "${label}" "${state}" "${detail}"
  else
    printf '%-34s %s\n' "${label}" "${state}"
  fi
}

doctor() {
  require_command curl
  require_command docker
  require_command sudo
  load_env

  local failures=0
  local sha="unknown"
  if git -C "${REPO_ROOT}" rev-parse --short=12 HEAD >/dev/null 2>&1; then
    sha=$(git -C "${REPO_ROOT}" rev-parse --short=12 HEAD)
  fi
  check_line "Repository" "ok" "${sha}"

  if systemctl is-active --quiet "${SERVICE_NAME}"; then
    check_line "Systemd active" "ok" "${SERVICE_NAME}"
  else
    check_line "Systemd active" "fail" "${SERVICE_NAME}"
    failures=$((failures + 1))
  fi

  if systemctl is-enabled --quiet "${SERVICE_NAME}"; then
    check_line "Systemd enabled" "ok" "${SERVICE_NAME}"
  else
    check_line "Systemd enabled" "fail" "${SERVICE_NAME}"
    failures=$((failures + 1))
  fi

  local container_status
  container_status=$(docker ps --filter "name=${CONTAINER_NAME}" --format '{{.Status}}' | head -n 1 || true)
  if [[ -n "${container_status}" ]]; then
    check_line "Container" "ok" "${container_status}"
  else
    check_line "Container" "fail" "${CONTAINER_NAME} not running"
    failures=$((failures + 1))
  fi

  local image_id
  image_id=$(docker image inspect "${IMAGE_NAME}" --format '{{.Id}}' 2>/dev/null | cut -d: -f2 | cut -c1-12 || true)
  if [[ -n "${image_id}" ]]; then
    check_line "Image" "ok" "${IMAGE_NAME}@${image_id}"
  else
    check_line "Image" "fail" "${IMAGE_NAME} missing"
    failures=$((failures + 1))
  fi

  local kaosai_mode="disabled"
  if [[ "${KAOSAI_ENABLED:-false}" == "true" ]]; then
    if [[ "${KAOSAI_DRY_RUN_ENABLED:-false}" == "true" ]]; then
      kaosai_mode="dry-run"
    elif [[ "${KAOSAI_CHAT_ENABLED:-false}" == "true" ]]; then
      kaosai_mode="chat"
    else
      kaosai_mode="diagnostic"
    fi
  fi
  check_line "KaosAI mode" "ok" "${kaosai_mode}"

  local ollama_tags
  if ollama_tags=$(curl --fail --silent --show-error "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}/api/tags"); then
    check_line "Ollama" "ok" "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
    python3 - "$ollama_tags" "${KAOSBRAIN_CHAT_MODEL:-}" "${KAOSBRAIN_DEEP_MODEL:-}" "${KAOSBRAIN_IMAGING_MODEL:-}" "${KAOSBRAIN_IMAGING_ENABLED:-false}" "${KAOSBRAIN_IMAGING_PROVIDER:-ollama}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
chat = sys.argv[2]
deep = sys.argv[3]
imaging = sys.argv[4]
imaging_enabled = sys.argv[5].lower() in {"1", "true", "yes", "on"}
imaging_provider = sys.argv[6].lower()
names = {model.get("name", "") for model in payload.get("models", [])}
for label, model in (("Chat model", chat), ("Deep model", deep)):
    state = "ok" if model and model in names else "missing"
    print(f"{label:<34} {state} ({model or 'unset'})")
if imaging_enabled and imaging_provider == "ollama":
    state = "ok" if imaging and imaging in names else "missing"
    print(f"{'Imaging model':<34} {state} ({imaging or 'unset'})")
PY
  else
    check_line "Ollama" "fail" "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
    failures=$((failures + 1))
  fi

  if [[ "${KAOSBRAIN_GOVERNOR_TOOLS_ENABLED:-false}" == "true" ]]; then
    local tools_url=${KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL:-}
    if [[ -z "${tools_url}" ]]; then
      check_line "Governor tools" "fail" "missing KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL"
      failures=$((failures + 1))
    else
      local tools_code
      tools_code=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
        "${tools_url%/}/tools/today?profile=${KAOSBRAIN_GOVERNOR_TOOLS_PROFILE:-main}" || true)
      case "${tools_code}" in
        200|401|403) check_line "Governor tools route" "ok" "http ${tools_code}" ;;
        *) check_line "Governor tools route" "fail" "http ${tools_code:-000}"; failures=$((failures + 1)) ;;
      esac
    fi
  else
    check_line "Governor tools" "disabled"
  fi

  if [[ "${KAOSBRAIN_IMAGING_ENABLED:-false}" == "true" ]]; then
    if [[ "${KAOSBRAIN_IMAGING_PROVIDER:-ollama}" == "kaosai" ]]; then
      check_line "KaosBrain imaging" "ok" "enabled, provider=kaosai, model=${KAOSAI_MODEL:-default}"
    else
      check_line "KaosBrain imaging" "ok" "enabled, provider=ollama, model=${KAOSBRAIN_IMAGING_MODEL:-unset}"
    fi
  else
    check_line "KaosBrain imaging" "disabled"
  fi

  if [[ -n "${KAOSBRAIN_GOVERNOR_HEALTH_URL:-}" ]]; then
    local health_url=${KAOSBRAIN_GOVERNOR_HEALTH_URL%/}
    if [[ "${health_url}" != */health ]]; then
      health_url="${health_url}/health"
    fi
    local health_payload
    if health_payload=$(curl --fail --silent --show-error "${health_url}"); then
      python3 - "$health_payload" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
status = payload.get("status", "unknown")
discord_ready = payload.get("discordReady", payload.get("discord_ready", "unknown"))
brain_tools = payload.get("brainTools", payload.get("brain_tools", {}))
service_status = payload.get("serviceStatus", payload.get("service_status", {}))
raw_checks = service_status.get("checks", []) if isinstance(service_status, dict) else []
if isinstance(raw_checks, dict):
    checks = raw_checks.values()
else:
    checks = raw_checks
states = {}
for check in checks:
    if not isinstance(check, dict):
        continue
    status_value = check.get("status", "unknown")
    states[status_value] = states.get(status_value, 0) + 1
state_text = ", ".join(f"{key}={value}" for key, value in sorted(states.items())) or "no services"
host_text = payload.get("hostname") or payload.get("host") or "reachable"
print(f"{'Governor health':<34} {status} ({host_text})")
print(f"{'Governor Discord':<34} ok (ready={discord_ready})")
if isinstance(brain_tools, dict):
    print(f"{'Governor brain tools':<34} ok (enabled={brain_tools.get('enabled', 'unknown')})")
if isinstance(service_status, dict):
    print(f"{'System controller':<34} ok (enabled={service_status.get('enabled', 'unknown')}, {state_text})")
PY
    else
      check_line "System controller" "fail" "${health_url}"
      failures=$((failures + 1))
    fi
  else
    check_line "System controller" "not configured" "KAOSBRAIN_GOVERNOR_HEALTH_URL"
  fi

  if [[ "${failures}" -gt 0 ]]; then
    die "doctor found ${failures} failing check(s)"
  fi
}

up() {
  preflight
  build_image
  sudo systemctl restart "${SERVICE_NAME}"
  smoke
}

deploy() {
  require_command git
  git -C "${REPO_ROOT}" pull --ff-only origin main
  up
}

status() {
  sudo systemctl status "${SERVICE_NAME}" --no-pager
  docker ps --filter "name=${CONTAINER_NAME}" --format '{{.Names}} {{.Image}} {{.Status}}'
}

kaosai_mode() {
  local mode=${1:-}
  case "${mode}" in
    disabled|diagnostic|dry-run|chat) ;;
    "") die "usage: ${0} kaosai-mode <disabled|diagnostic|dry-run|chat>" ;;
    *) die "unknown KaosAI mode: ${mode}" ;;
  esac

  [[ -f "${ENV_FILE}" ]] || die "missing env file: ${ENV_FILE}; run ${0} setup"
  local backup
  backup=$(mktemp "${ENV_FILE}.backup.XXXXXX")
  cp -p "${ENV_FILE}" "${backup}"

  enable_kaosai_defaults() {
    set_env_value KAOSAI_ENABLED true
    set_env_value KAOSAI_PROVIDER openclaw
    if [[ -z "${KAOSAI_BASE_URL:-}" ]]; then
      set_env_value KAOSAI_BASE_URL http://127.0.0.1:18789
    fi
    if [[ -z "${KAOSAI_API_TOKEN:-}" && -z "${KAOSAI_API_TOKEN_FILE:-}" ]]; then
      set_env_value KAOSAI_API_TOKEN_FILE /run/secrets/openclaw_gateway_token
    fi
  }

  case "${mode}" in
    disabled)
      set_env_value KAOSAI_ENABLED false
      set_env_value KAOSAI_CHAT_ENABLED false
      set_env_value KAOSAI_DRY_RUN_ENABLED false
      ;;
    diagnostic)
      enable_kaosai_defaults
      set_env_value KAOSAI_CHAT_ENABLED false
      set_env_value KAOSAI_DRY_RUN_ENABLED false
      ;;
    dry-run)
      enable_kaosai_defaults
      set_env_value KAOSAI_CHAT_ENABLED false
      set_env_value KAOSAI_DRY_RUN_ENABLED true
      ;;
    chat)
      enable_kaosai_defaults
      set_env_value KAOSAI_CHAT_ENABLED true
      set_env_value KAOSAI_DRY_RUN_ENABLED false
      ;;
  esac

  if ! preflight; then
    cp -p "${backup}" "${ENV_FILE}"
    rm -f "${backup}"
    die "KaosAI mode change failed preflight; restored ${ENV_FILE}"
  fi
  rm -f "${backup}"
  info "KaosAI mode set to ${mode}. Run ${0} up to restart Brain with this mode."
}

logs() {
  docker logs --tail "${1:-120}" "${CONTAINER_NAME}"
}

usage() {
  cat <<EOF
Usage: ${0} <command>

Commands:
  setup      Create env/secret paths and install the systemd unit
  preflight  Validate host, env, secret, and Ollama reachability
  test       Build and run the Brain test image
  build      Build the runtime image
  up         Run preflight, build, restart, and smoke check
  deploy     git pull --ff-only origin main, then up
  doctor     Check Brain service, Ollama, Governor tools, and system controller
  status     Show systemd and container status
  kaosai-mode <disabled|diagnostic|dry-run|chat>
             Update KaosAI mode in the Brain env, validate, and leave restart explicit
  logs [n]   Show recent container logs
EOF
}

case "${1:-}" in
  setup) setup ;;
  preflight) preflight ;;
  test) test_image ;;
  build) build_image ;;
  up) up ;;
  deploy) deploy ;;
  doctor) doctor ;;
  status) status ;;
  kaosai-mode) shift; kaosai_mode "$@" ;;
  logs) shift; logs "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1" ;;
esac
