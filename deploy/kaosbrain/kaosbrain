#!/usr/bin/env bash
set -euo pipefail

DEPLOY_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${DEPLOY_DIR}/../.." && pwd)
KAOSGDD_ROOT=${KAOSGDD_ROOT:-/srv/kaosgdd}
LEGACY_ROOT=${KAOSBRAIN_LEGACY_ROOT:-/srv/kaos}
CANONICAL_ENV_DIR=${KAOSGDD_ROOT}/kaosbrain
CANONICAL_SECRETS_DIR=${KAOSGDD_ROOT}/secrets
if [[ -z "${KAOSBRAIN_ENV_DIR:-}" && -f "${LEGACY_ROOT}/brain/kaosbrain.env" && ! -f "${CANONICAL_ENV_DIR}/kaosbrain.env" ]]; then
  ENV_DIR=${LEGACY_ROOT}/brain
else
  ENV_DIR=${KAOSBRAIN_ENV_DIR:-${CANONICAL_ENV_DIR}}
fi
ENV_FILE=${KAOSBRAIN_ENV_FILE:-${ENV_DIR}/kaosbrain.env}
if [[ -z "${KAOSBRAIN_SECRETS_DIR:-}" && -f "${LEGACY_ROOT}/secrets/governor_api_token" && ! -f "${CANONICAL_SECRETS_DIR}/governor_api_token" ]]; then
  SECRETS_DIR=${LEGACY_ROOT}/secrets
else
  SECRETS_DIR=${KAOSBRAIN_SECRETS_DIR:-${CANONICAL_SECRETS_DIR}}
fi
GOVERNOR_TOKEN_FILE=${KAOSBRAIN_GOVERNOR_TOKEN_FILE:-${SECRETS_DIR}/governor_api_token}
SERVICE_NAME=${KAOSBRAIN_SERVICE_NAME:-kaosbrain.service}
SYSTEMD_UNIT_DIR=${KAOSBRAIN_SYSTEMD_UNIT_DIR:-/etc/systemd/system}
IMAGE_NAME=${KAOSBRAIN_IMAGE_NAME:-kaos-brain:current}
CANDIDATE_IMAGE_NAME=${KAOSBRAIN_CANDIDATE_IMAGE_NAME:-${IMAGE_NAME%:*}:candidate}
ROLLBACK_IMAGE_NAME=${KAOSBRAIN_ROLLBACK_IMAGE_NAME:-${IMAGE_NAME%:*}:pre-headless-discord-retirement}
CONTAINER_NAME=${KAOSBRAIN_CONTAINER_NAME:-kaos-brain}
OPENCLAW_STATE_DIR=${KAOSAI_OPENCLAW_STATE_DIR:-${KAOSGDD_ROOT}/kaosai/openclaw}
OPENCLAW_CONFIG_PATH=${KAOSAI_OPENCLAW_CONFIG_PATH:-${OPENCLAW_STATE_DIR}/openclaw.json}
OPENCLAW_GATEWAY_SERVICE=${KAOSAI_OPENCLAW_GATEWAY_SERVICE:-openclaw-gateway.service}
REAUTH_AGENT_ENV_FILE=${KAOSAI_REAUTH_AGENT_ENV_FILE:-${KAOSGDD_ROOT}/kaosai/openclaw-reauth-agent.env}
REAUTH_AGENT_TOKEN_FILE=${KAOSAI_REAUTH_AGENT_TOKEN_FILE:-${CANONICAL_SECRETS_DIR}/kaosai_reauth_agent_token}
REAUTH_AGENT_VENV_DIR=${KAOSAI_REAUTH_AGENT_VENV_DIR:-${KAOSGDD_ROOT}/kaosai/openclaw-reauth-agent-venv}
REAUTH_AGENT_SERVICE_NAME=${KAOSAI_REAUTH_AGENT_SERVICE_NAME:-kaosai-openclaw-reauth-agent.service}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

load_openclaw_cli() {
  if command -v openclaw >/dev/null 2>&1 && node -v 2>/dev/null | grep -Eq '^v(22|24|25)\.'; then
    return
  fi
  if [[ -s "${HOME}/.nvm/nvm.sh" ]]; then
    # shellcheck disable=SC1091
    source "${HOME}/.nvm/nvm.sh"
    nvm use 24 >/dev/null || true
  fi
  command -v openclaw >/dev/null 2>&1 || die "openclaw CLI is required"
  node -v 2>/dev/null | grep -Eq '^v(22|24|25)\.' || die "OpenClaw requires Node 22, 24, or 25"
}

export_openclaw_env() {
  export OPENCLAW_STATE_DIR
  export OPENCLAW_CONFIG_PATH
}

load_env() {
  [[ -f "${ENV_FILE}" ]] || die "missing env file: ${ENV_FILE}; run ${0} setup"
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
}

host_secret_path() {
  local path=$1
  if [[ "${path}" == /run/secrets/* ]]; then
    printf '%s/%s' "${SECRETS_DIR}" "${path##*/}"
    return
  fi
  printf '%s' "${path}"
}

sed_escape() {
  printf '%s' "$1" | sed -e 's/[\/&]/\\&/g'
}

set_env_value() {
  local key=$1
  local value=$2
  local escaped_value
  escaped_value=$(sed_escape "${value}")
  if grep -q "^${key}=" "${ENV_FILE}"; then
    sed -i "s/^${key}=.*/${key}=${escaped_value}/" "${ENV_FILE}"
  else
    printf '%s=%s\n' "${key}" "${value}" >>"${ENV_FILE}"
  fi
}

ensure_upgrade_defaults() {
  local preview=${1:-false}
  [[ -f "${ENV_FILE}" ]] || die "missing env file: ${ENV_FILE}; run ${0} setup"
  load_env
  local retirement_backup="${ENV_FILE}.pre-headless-discord-retirement"
  local retirement_pattern='^(DISCORD_|KAOSBRAIN_TOKEN_FILE=|KAOSBRAIN_(MAX_REPLY_CHARS|RESPOND_WITHOUT_MENTION|AUTO_ROUTE_ENABLED|ACTIVE_CONTROL_|HEALTH_ENABLED)|KAOSAI_(CHAT|DRY_RUN)_ENABLED=|KAOSBRAIN_GOVERNOR_HEALTH_URL=)'
  local transport_pattern='^(DISCORD_|KAOSBRAIN_TOKEN_FILE=|KAOSBRAIN_(MAX_REPLY_CHARS|RESPOND_WITHOUT_MENTION|AUTO_ROUTE_ENABLED|ACTIVE_CONTROL_|HEALTH_ENABLED)|KAOSAI_(CHAT|DRY_RUN)_ENABLED=)'
  if grep -Eq "${retirement_pattern}" "${ENV_FILE}"; then
    if [[ "${preview}" != "true" && ! -e "${retirement_backup}" ]]; then
      cp -p "${ENV_FILE}" "${retirement_backup}"
      info "Saved permission-preserving pre-retirement env backup: ${retirement_backup}"
    elif [[ "${preview}" != "true" ]]; then
      info "Pre-retirement env backup already exists: ${retirement_backup}"
    fi
  fi
  if grep -Eq "${transport_pattern}" "${ENV_FILE}"; then
    sed -i -E "/${transport_pattern}/d" "${ENV_FILE}"
    [[ "${preview}" == "true" ]] || info "Removed retired Discord/chat transport settings from ${ENV_FILE}."
  fi
  if grep -q '^KAOSBRAIN_GOVERNOR_HEALTH_URL=' "${ENV_FILE}"; then
    local legacy_health_url=${KAOSBRAIN_GOVERNOR_HEALTH_URL:-}
    if [[ -z "${KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL:-}" && "${legacy_health_url}" =~ ^(http://.+):8097(/health)?/?$ ]]; then
      set_env_value KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL "${BASH_REMATCH[1]}:8098"
      [[ "${preview}" == "true" ]] || info "Migrated Governor tools base URL from retired port 8097 to 8098."
    fi
    sed -i '/^KAOSBRAIN_GOVERNOR_HEALTH_URL=/d' "${ENV_FILE}"
    [[ "${preview}" == "true" ]] || info "Removed retired KAOSBRAIN_GOVERNOR_HEALTH_URL; doctor now uses the Governor tools /health route."
  fi
  if [[ -z "${KAOSBRAIN_AI_TASK_API_TOKEN:-}" \
    && -z "${KAOSBRAIN_AI_TASK_API_TOKEN_FILE:-}" ]]; then
    set_env_value KAOSBRAIN_AI_TASK_API_TOKEN_FILE /run/secrets/governor_api_token
    [[ "${preview}" == "true" ]] || info "Added KAOSBRAIN_AI_TASK_API_TOKEN_FILE for protected headless routes."
  fi
}

prospective_preflight() (
  local source_env=${ENV_FILE}
  local preview_dir
  preview_dir=$(mktemp -d)
  trap 'rm -rf -- "${preview_dir}"' EXIT
  local ENV_FILE="${preview_dir}/kaosbrain.env"
  cp -p "${source_env}" "${ENV_FILE}"
  ensure_upgrade_defaults true
  preflight
)

path_exists() {
  [[ -e "$1" || -L "$1" ]]
}

declare -a RETIRED_DISCORD_SECRET_SOURCES=()
declare -a RETIRED_DISCORD_SECRET_DESTINATIONS=()
declare -a QUARANTINED_DISCORD_SECRET_SOURCES=()
declare -a QUARANTINED_DISCORD_SECRET_DESTINATIONS=()

add_retired_discord_secret() {
  local source=$1
  local destination=$2
  local existing
  [[ -n "${source}" ]] || return 0
  for existing in "${RETIRED_DISCORD_SECRET_SOURCES[@]}"; do
    [[ "${existing}" != "${source}" ]] || return 0
  done
  RETIRED_DISCORD_SECRET_SOURCES+=("${source}")
  RETIRED_DISCORD_SECRET_DESTINATIONS+=("${destination}")
}

collect_retired_discord_secrets() {
  local retired_dir="${CANONICAL_ENV_DIR}/retired-secrets"
  local canonical_source="${CANONICAL_SECRETS_DIR}/kaosbrain_discord_bot_token"
  local legacy_source="${LEGACY_ROOT}/secrets/kaosbrain_discord_bot_token"
  local effective_source="${SECRETS_DIR}/kaosbrain_discord_bot_token"
  local configured_host_source=${KAOSBRAIN_TOKEN_FILE:-}
  local configured_runtime_source=${DISCORD_BOT_TOKEN_FILE:-}

  if [[ -n "${configured_host_source}" ]]; then
    configured_host_source=$(host_secret_path "${configured_host_source}")
  fi
  if [[ -n "${configured_runtime_source}" ]]; then
    if [[ "${configured_runtime_source}" != /run/secrets/* ]]; then
      printf 'ERROR: cannot safely resolve retired DISCORD_BOT_TOKEN_FILE outside /run/secrets: %s\n' "${configured_runtime_source}" >&2
      return 1
    fi
    configured_runtime_source=$(host_secret_path "${configured_runtime_source}")
  fi

  RETIRED_DISCORD_SECRET_SOURCES=()
  RETIRED_DISCORD_SECRET_DESTINATIONS=()
  add_retired_discord_secret "${canonical_source}" "${retired_dir}/canonical-kaosbrain_discord_bot_token"
  add_retired_discord_secret "${legacy_source}" "${retired_dir}/legacy-kaosbrain_discord_bot_token"
  add_retired_discord_secret "${effective_source}" "${retired_dir}/effective-kaosbrain_discord_bot_token"
  add_retired_discord_secret "${configured_host_source}" "${retired_dir}/configured-host-kaosbrain_discord_bot_token"
  add_retired_discord_secret "${configured_runtime_source}" "${retired_dir}/configured-runtime-kaosbrain_discord_bot_token"
}

retired_discord_secret_is_active_headless_secret() {
  local source=$1
  local configured protected
  local -a protected_paths=("${GOVERNOR_TOKEN_FILE}")
  for configured in \
    "${GOVERNOR_API_TOKEN_FILE:-/run/secrets/governor_api_token}" \
    "${KAOSBRAIN_AI_TASK_API_TOKEN_FILE:-}" \
    "${KAOSBRAIN_CALENDAR_PREVIEW_API_TOKEN_FILE:-}" \
    "${KAOSBRAIN_DOCUMENT_TAG_API_TOKEN_FILE:-}" \
    "${KAOSBRAIN_IMAGING_API_TOKEN_FILE:-}" \
    "${KAOSAI_API_TOKEN_FILE:-}" \
    "${KAOSAI_REAUTH_TOKEN_FILE:-}" \
    "${KAOSBRAIN_OPENAI_API_KEY_FILE:-}"; do
    [[ -n "${configured}" ]] || continue
    protected_paths+=("$(host_secret_path "${configured}")")
  done
  for protected in "${protected_paths[@]}"; do
    [[ -n "${protected}" ]] || continue
    if [[ "${source}" == "${protected}" ]] \
      || { path_exists "${source}" && path_exists "${protected}" && [[ "${source}" -ef "${protected}" ]]; }; then
      return 0
    fi
  done
  return 1
}

validate_retired_discord_secret_quarantine() {
  local retired_dir="${CANONICAL_ENV_DIR}/retired-secrets"
  local found=false
  local index source destination

  collect_retired_discord_secrets || return 1
  if [[ -L "${retired_dir}" || ( -e "${retired_dir}" && ! -d "${retired_dir}" ) ]]; then
    printf 'ERROR: retired Discord secret quarantine path is not a regular directory: %s\n' "${retired_dir}" >&2
    return 1
  fi

  for index in "${!RETIRED_DISCORD_SECRET_SOURCES[@]}"; do
    source=${RETIRED_DISCORD_SECRET_SOURCES[index]}
    destination=${RETIRED_DISCORD_SECRET_DESTINATIONS[index]}
    if [[ "${source}" != /* ]]; then
      printf 'ERROR: retired Discord secret path must be absolute: %s\n' "${source}" >&2
      return 1
    fi
    if path_exists "${source}"; then
      found=true
      if retired_discord_secret_is_active_headless_secret "${source}"; then
        printf 'ERROR: refusing to quarantine a Discord token path still configured for a headless secret: %s\n' "${source}" >&2
        return 1
      fi
      if [[ -L "${source}" || ! -f "${source}" ]]; then
        printf 'ERROR: refusing to quarantine a non-regular or symlinked Discord secret: %s\n' "${source}" >&2
        return 1
      fi
      if path_exists "${destination}"; then
        printf 'ERROR: refusing to overwrite retired Discord secret quarantine target: %s\n' "${destination}" >&2
        return 1
      fi
    fi
  done
  [[ "${found}" == "true" ]] || return 0
}

quarantine_retired_discord_secrets() {
  local retired_dir="${CANONICAL_ENV_DIR}/retired-secrets"
  local index source destination

  validate_retired_discord_secret_quarantine || return 1
  QUARANTINED_DISCORD_SECRET_SOURCES=()
  QUARANTINED_DISCORD_SECRET_DESTINATIONS=()
  local found=false
  for source in "${RETIRED_DISCORD_SECRET_SOURCES[@]}"; do
    if path_exists "${source}"; then
      found=true
      break
    fi
  done
  [[ "${found}" == "true" ]] || return 0

  if ! sudo install -d -m 0700 -o "$(id -un)" -g "$(id -gn)" "${retired_dir}" \
    || ! sudo chmod 0700 "${retired_dir}"; then
    printf 'ERROR: failed to prepare retired Discord secret quarantine directory: %s\n' "${retired_dir}" >&2
    return 1
  fi
  for index in "${!RETIRED_DISCORD_SECRET_SOURCES[@]}"; do
    source=${RETIRED_DISCORD_SECRET_SOURCES[index]}
    destination=${RETIRED_DISCORD_SECRET_DESTINATIONS[index]}
    if ! path_exists "${source}"; then
      continue
    fi
    if ! sudo mv -T -n -- "${source}" "${destination}"; then
      printf 'ERROR: failed to quarantine retired Discord secret: %s\n' "${source}" >&2
      return 1
    fi
    if ! path_exists "${source}" && path_exists "${destination}"; then
      QUARANTINED_DISCORD_SECRET_SOURCES+=("${source}")
      QUARANTINED_DISCORD_SECRET_DESTINATIONS+=("${destination}")
    fi
    if path_exists "${source}" || [[ -L "${destination}" || ! -f "${destination}" ]]; then
      printf 'ERROR: failed to quarantine retired Discord secret without overwrite: %s\n' "${source}" >&2
      return 1
    fi
    info "Quarantined retired Discord secret: ${destination}"
  done
}

restore_quarantined_discord_secrets() {
  local index source destination failures=0
  for ((index=${#QUARANTINED_DISCORD_SECRET_SOURCES[@]} - 1; index >= 0; index--)); do
    source=${QUARANTINED_DISCORD_SECRET_SOURCES[index]}
    destination=${QUARANTINED_DISCORD_SECRET_DESTINATIONS[index]}
    if path_exists "${source}"; then
      printf 'ERROR: refusing to overwrite Discord secret while rolling back: %s\n' "${source}" >&2
      failures=$((failures + 1))
      continue
    fi
    if [[ -L "${destination}" || ! -f "${destination}" ]]; then
      printf 'ERROR: quarantined Discord secret is no longer a regular file: %s\n' "${destination}" >&2
      failures=$((failures + 1))
      continue
    fi
    if ! sudo mv -T -n -- "${destination}" "${source}" || path_exists "${destination}" || ! path_exists "${source}"; then
      printf 'ERROR: failed to restore quarantined Discord secret: %s\n' "${source}" >&2
      failures=$((failures + 1))
    fi
  done
  [[ "${failures}" -eq 0 ]]
}

validate_internal_http_url() {
  local name=$1
  local url=$2
  local allow_path=${3:-false}
  [[ "${url}" == http://* ]] || die "${name} must be an internal http URL"
  local rest=${url#http://}
  [[ "${rest}" != *"@"* ]] || die "${name} must not include credentials"
  local hostport=${rest%%/*}
  [[ -n "${hostport}" ]] || die "${name} must include a host"
  local path=""
  if [[ "${rest}" == */* ]]; then
    path="/${rest#*/}"
  fi
  if [[ "${allow_path}" != "true" && -n "${path}" && "${path}" != "/" ]]; then
    die "${name} must be a base URL without path"
  fi
  [[ "${url}" != *"?"* && "${url}" != *"#"* ]] || die "${name} must not include query or fragment"

  local host=${hostport}
  if [[ "${host}" == \[*\]* ]]; then
    host=${host#\[}
    host=${host%%\]*}
  else
    host=${host%%:*}
  fi
  host=${host%.}
  case "${host}" in
    kaosgdd.net|*.kaosgdd.net)
      die "${name} must not point at a public KaosGDD route"
      ;;
  esac
}

install_service_unit() {
  local unit_path="${SYSTEMD_UNIT_DIR}/${SERVICE_NAME}"
  sudo sed \
    -e "s/__KAOSBRAIN_ENV_FILE__/$(sed_escape "${ENV_FILE}")/g" \
    -e "s/__KAOSBRAIN_SECRETS_DIR__/$(sed_escape "${SECRETS_DIR}")/g" \
    -e "s/__KAOSBRAIN_IMAGE_NAME__/$(sed_escape "${IMAGE_NAME}")/g" \
    -e "s/__KAOSBRAIN_CONTAINER_NAME__/$(sed_escape "${CONTAINER_NAME}")/g" \
    "${DEPLOY_DIR}/kaosbrain.service" | sudo tee "${unit_path}" >/dev/null
}

setup() {
  require_command docker
  require_command sudo
  sudo install -d -m 0750 -o "$USER" -g "$(id -gn)" "${ENV_DIR}" "${SECRETS_DIR}"
  if [[ ! -f "${ENV_FILE}" ]]; then
    cp "${DEPLOY_DIR}/.env.example" "${ENV_FILE}"
    sed -i "s/^KAOS_HOST_UID=.*/KAOS_HOST_UID=$(id -u)/" "${ENV_FILE}"
    sed -i "s/^KAOS_HOST_GID=.*/KAOS_HOST_GID=$(id -g)/" "${ENV_FILE}"
    info "Created ${ENV_FILE}"
  fi
  if [[ ! -e "${GOVERNOR_TOKEN_FILE}" ]]; then
    : > "${GOVERNOR_TOKEN_FILE}"
  fi
  chmod 0640 "${GOVERNOR_TOKEN_FILE}"
  install_service_unit
  sudo systemctl daemon-reload
  sudo systemctl enable "${SERVICE_NAME}" >/dev/null
  info "Setup complete. Fill ${ENV_FILE} and any enabled route/provider secret files, then run:"
  info "  ${0} test"
  info "  ${0} up"
}

preflight() {
  require_command docker
  require_command curl
  require_command python3
  require_command sudo
  load_env
  if [[ "${KAOSBRAIN_GOVERNOR_TOOLS_ENABLED:-false}" == "true" ]]; then
    [[ -n "${KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL:-}" ]] || die "KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL is required"
    validate_internal_http_url "KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL" "${KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL}"
    if [[ -z "${GOVERNOR_API_TOKEN:-}" ]]; then
      local governor_token_path
      governor_token_path=$(host_secret_path "${GOVERNOR_API_TOKEN_FILE:-/run/secrets/governor_api_token}")
      [[ -s "${governor_token_path}" ]] || die "missing or empty Governor token file: ${governor_token_path}"
    fi
  fi
  if [[ -z "${KAOSBRAIN_CALENDAR_PREVIEW_API_TOKEN:-}" && -n "${KAOSBRAIN_CALENDAR_PREVIEW_API_TOKEN_FILE:-}" ]]; then
    local calendar_preview_token_path
    calendar_preview_token_path=$(host_secret_path "${KAOSBRAIN_CALENDAR_PREVIEW_API_TOKEN_FILE}")
    [[ -s "${calendar_preview_token_path}" ]] || die "missing or empty KaosBrain calendar preview token file: ${calendar_preview_token_path}"
  fi
  if [[ -z "${KAOSBRAIN_DOCUMENT_TAG_API_TOKEN:-}" && -n "${KAOSBRAIN_DOCUMENT_TAG_API_TOKEN_FILE:-}" ]]; then
    local document_tag_token_path
    document_tag_token_path=$(host_secret_path "${KAOSBRAIN_DOCUMENT_TAG_API_TOKEN_FILE}")
    [[ -s "${document_tag_token_path}" ]] || die "missing or empty KaosBrain document tag token file: ${document_tag_token_path}"
  fi
  if [[ -z "${KAOSBRAIN_AI_TASK_API_TOKEN:-}" && -z "${KAOSBRAIN_AI_TASK_API_TOKEN_FILE:-}" ]]; then
    die "KAOSBRAIN_AI_TASK_API_TOKEN or KAOSBRAIN_AI_TASK_API_TOKEN_FILE is required for protected headless routes"
  elif [[ -z "${KAOSBRAIN_AI_TASK_API_TOKEN:-}" ]]; then
    local ai_task_token_path
    ai_task_token_path=$(host_secret_path "${KAOSBRAIN_AI_TASK_API_TOKEN_FILE}")
    [[ -s "${ai_task_token_path}" ]] || die "missing or empty KaosBrain AI task token file: ${ai_task_token_path}"
  fi
  if [[ "${KAOSBRAIN_IMAGING_ENABLED:-false}" == "true" ]]; then
    case "${KAOSBRAIN_IMAGING_PROVIDER:-ollama}" in
      ollama|kaosai|kaosbrain-openai) ;;
      *) die "KAOSBRAIN_IMAGING_PROVIDER must be ollama or kaosbrain-openai" ;;
    esac
    if [[ -z "${KAOSBRAIN_IMAGING_API_TOKEN:-}" ]]; then
      local imaging_token_path
      imaging_token_path=$(host_secret_path "${KAOSBRAIN_IMAGING_API_TOKEN_FILE:-/run/secrets/governor_api_token}")
      [[ -s "${imaging_token_path}" ]] || die "missing or empty KaosBrain imaging token file: ${imaging_token_path}"
    fi
    if [[ "${KAOSBRAIN_IMAGING_PROVIDER:-ollama}" =~ ^(kaosai|kaosbrain-openai)$ && "${KAOSAI_ENABLED:-false}" != "true" ]]; then
      die "KAOSAI_ENABLED=true is required when KAOSBRAIN_IMAGING_PROVIDER=kaosbrain-openai"
    fi
  fi
  if [[ "${KAOSAI_ENABLED:-false}" == "true" ]]; then
    [[ "${KAOSAI_PROVIDER:-}" == "openclaw" ]] || die "KAOSAI_PROVIDER must be openclaw when KAOSAI_ENABLED=true"
    [[ -n "${KAOSAI_BASE_URL:-}" ]] || die "KAOSAI_BASE_URL is required when KAOSAI_ENABLED=true"
    if [[ -z "${KAOSAI_API_TOKEN:-}" && -z "${KAOSAI_API_TOKEN_FILE:-}" ]]; then
      die "KAOSAI_API_TOKEN or KAOSAI_API_TOKEN_FILE is required when KAOSAI_ENABLED=true"
    fi
    if [[ -z "${KAOSAI_API_TOKEN:-}" && -n "${KAOSAI_API_TOKEN_FILE:-}" ]]; then
      local kaosai_token_path
      kaosai_token_path=$(host_secret_path "${KAOSAI_API_TOKEN_FILE}")
      [[ -s "${kaosai_token_path}" ]] || die "missing or empty KaosBrain-OpenAI token file: ${kaosai_token_path}"
    fi
  fi
  if [[ "${KAOSAI_REAUTH_ENABLED:-false}" == "true" ]]; then
    [[ -n "${KAOSAI_REAUTH_BASE_URL:-}" ]] || die "KAOSAI_REAUTH_BASE_URL is required when KAOSAI_REAUTH_ENABLED=true"
    validate_internal_http_url "KAOSAI_REAUTH_BASE_URL" "${KAOSAI_REAUTH_BASE_URL}"
    if [[ -z "${KAOSBRAIN_AI_TASK_API_TOKEN:-}" && -z "${KAOSBRAIN_AI_TASK_API_TOKEN_FILE:-}" ]]; then
      die "KAOSBRAIN_AI_TASK_API_TOKEN or KAOSBRAIN_AI_TASK_API_TOKEN_FILE is required when KAOSAI_REAUTH_ENABLED=true"
    fi
    if [[ -z "${KAOSAI_REAUTH_TOKEN:-}" ]]; then
      local reauth_token_path
      reauth_token_path=$(host_secret_path "${KAOSAI_REAUTH_TOKEN_FILE:-/run/secrets/kaosai_reauth_agent_token}")
      [[ -s "${reauth_token_path}" ]] || die "missing or empty KaosBrain-OpenAI reauth token file: ${reauth_token_path}"
    fi
  fi
  curl --fail --silent --show-error "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}/api/tags" >/dev/null \
    || die "Ollama is not reachable"
  info "Preflight passed."
}

test_image() {
  require_command docker
  docker build --target test \
    --tag kaosgdd-ai-brain:test \
    --file "${REPO_ROOT}/apps/brain/Dockerfile" \
    "${REPO_ROOT}"
  docker run --rm kaosgdd-ai-brain:test
}

build_image() {
  local target_image=${1:-${IMAGE_NAME}}
  require_command docker
  docker build --target runtime \
    --tag "${target_image}" \
    --file "${REPO_ROOT}/apps/brain/Dockerfile" \
    "${REPO_ROOT}"
}

smoke_authenticated_headless_route() {
  local base_url=$1
  local brain_api_token=${KAOSBRAIN_AI_TASK_API_TOKEN:-}
  if [[ -z "${brain_api_token}" ]]; then
    local token_path
    token_path=$(host_secret_path "${KAOSBRAIN_AI_TASK_API_TOKEN_FILE:-}")
    if [[ -z "${token_path}" || ! -r "${token_path}" ]]; then
      printf 'ERROR: cannot read the token for the authenticated KaosBrain smoke check\n' >&2
      return 1
    fi
    brain_api_token=$(<"${token_path}")
  fi
  if [[ -z "${brain_api_token}" || "${brain_api_token}" == *$'\r'* || "${brain_api_token}" == *$'\n'* ]]; then
    unset brain_api_token
    printf 'ERROR: invalid token for the authenticated KaosBrain smoke check\n' >&2
    return 1
  fi

  local auth_code
  if ! auth_code=$(printf 'Authorization: Bearer %s\n' "${brain_api_token}" \
    | curl --header @- --silent --show-error --output /dev/null --write-out '%{http_code}' \
      "${base_url}/internal/openclaw-auth/status"); then
    unset brain_api_token
    printf 'ERROR: authenticated KaosBrain route is unreachable\n' >&2
    return 1
  fi
  unset brain_api_token
  case "${auth_code}" in
    200|503)
      info "Authenticated KaosBrain route passed (HTTP ${auth_code})."
      ;;
    401)
      printf 'ERROR: authenticated KaosBrain route rejected its configured token (HTTP 401)\n' >&2
      return 1
      ;;
    *)
      printf 'ERROR: authenticated KaosBrain route returned HTTP %s\n' "${auth_code:-000}" >&2
      return 1
      ;;
  esac
}

headless_health_payload_is_valid() {
  python3 - "$1" <<'PY' >/dev/null
import json
import sys

payload = json.loads(sys.argv[1])
if (
    payload.get("status") != "ok"
    or payload.get("service") != "kaos-brain"
    or payload.get("runtime") != "headless"
    or payload.get("httpReady") is not True
    or "discordReady" in payload
):
    raise SystemExit(1)
PY
}

smoke() {
  local attempt
  local health_host=${KAOSBRAIN_HEALTH_HOST:-127.0.0.1}
  case "${health_host}" in
    0.0.0.0|::) health_host=127.0.0.1 ;;
  esac
  local base_url="http://${health_host}:${KAOSBRAIN_HEALTH_PORT:-8099}"
  local health_url="${base_url}/health"
  local health_payload
  local ready=false
  for attempt in $(seq 1 20); do
    if docker ps --filter "name=${CONTAINER_NAME}" --filter "status=running" --format '{{.Names}}' | grep -qx "${CONTAINER_NAME}" \
      && health_payload=$(curl --fail --silent --show-error "${health_url}" 2>/dev/null) \
      && headless_health_payload_is_valid "${health_payload}"; then
      ready=true
      break
    fi
    sleep 1
  done
  if [[ "${ready}" != "true" ]]; then
    sudo systemctl status "${SERVICE_NAME}" --no-pager >&2 || true
    docker logs --tail 80 "${CONTAINER_NAME}" >&2 || true
    printf 'ERROR: KaosBrain container did not become running and healthy\n' >&2
    return 1
  fi
  docker logs --since 30s "${CONTAINER_NAME}" 2>&1 | tail -40 || true
  info "KaosBrain headless API is ready at ${health_url}."
  smoke_authenticated_headless_route "${base_url}"
}

check_line() {
  local label=$1
  local state=$2
  local detail=${3:-}
  if [[ -n "${detail}" ]]; then
    printf '%-34s %s (%s)\n' "${label}" "${state}" "${detail}"
  else
    printf '%-34s %s\n' "${label}" "${state}"
  fi
}

doctor() {
  require_command curl
  require_command docker
  require_command sudo
  load_env

  local failures=0
  local sha="unknown"
  if git -C "${REPO_ROOT}" rev-parse --short=12 HEAD >/dev/null 2>&1; then
    sha=$(git -C "${REPO_ROOT}" rev-parse --short=12 HEAD)
  fi
  check_line "Repository" "ok" "${sha}"

  if systemctl is-active --quiet "${SERVICE_NAME}"; then
    check_line "Systemd active" "ok" "${SERVICE_NAME}"
  else
    check_line "Systemd active" "fail" "${SERVICE_NAME}"
    failures=$((failures + 1))
  fi

  if systemctl is-enabled --quiet "${SERVICE_NAME}"; then
    check_line "Systemd enabled" "ok" "${SERVICE_NAME}"
  else
    check_line "Systemd enabled" "fail" "${SERVICE_NAME}"
    failures=$((failures + 1))
  fi

  local container_status
  container_status=$(docker ps --filter "name=${CONTAINER_NAME}" --format '{{.Status}}' | head -n 1 || true)
  if [[ -n "${container_status}" ]]; then
    check_line "Container" "ok" "${container_status}"
  else
    check_line "Container" "fail" "${CONTAINER_NAME} not running"
    failures=$((failures + 1))
  fi

  local image_id
  image_id=$(docker image inspect "${IMAGE_NAME}" --format '{{.Id}}' 2>/dev/null | cut -d: -f2 | cut -c1-12 || true)
  if [[ -n "${image_id}" ]]; then
    check_line "Image" "ok" "${IMAGE_NAME}@${image_id}"
  else
    check_line "Image" "fail" "${IMAGE_NAME} missing"
    failures=$((failures + 1))
  fi

  local brain_health_host=${KAOSBRAIN_HEALTH_HOST:-127.0.0.1}
  case "${brain_health_host}" in
    0.0.0.0|::) brain_health_host=127.0.0.1 ;;
  esac
  local brain_health_url="http://${brain_health_host}:${KAOSBRAIN_HEALTH_PORT:-8099}/health"
  local brain_health_payload
  if brain_health_payload=$(curl --fail --silent --show-error "${brain_health_url}"); then
    if python3 - "${brain_health_payload}" <<'PY' >/dev/null
import json
import sys

payload = json.loads(sys.argv[1])
if (
    payload.get("status") != "ok"
    or payload.get("service") != "kaos-brain"
    or payload.get("runtime") != "headless"
    or payload.get("httpReady") is not True
    or "discordReady" in payload
):
    raise SystemExit(1)
PY
    then
      check_line "Headless API" "ok" "${brain_health_url}"
    else
      check_line "Headless API" "fail" "unexpected health response"
      failures=$((failures + 1))
    fi
  else
    check_line "Headless API" "fail" "${brain_health_url}"
    failures=$((failures + 1))
  fi

  local kaosai_mode="disabled"
  [[ "${KAOSAI_ENABLED:-false}" != "true" ]] || kaosai_mode="enabled"
  check_line "KaosBrain-OpenAI mode" "ok" "${kaosai_mode}"

  local ollama_tags
  if ollama_tags=$(curl --fail --silent --show-error "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}/api/tags"); then
    check_line "Ollama" "ok" "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
    python3 - "$ollama_tags" "${KAOSBRAIN_CHAT_MODEL:-}" "${KAOSBRAIN_DEEP_MODEL:-}" "${KAOSBRAIN_IMAGING_MODEL:-}" "${KAOSBRAIN_IMAGING_ENABLED:-false}" "${KAOSBRAIN_IMAGING_PROVIDER:-ollama}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
chat = sys.argv[2]
deep = sys.argv[3]
imaging = sys.argv[4]
imaging_enabled = sys.argv[5].lower() in {"1", "true", "yes", "on"}
imaging_provider = sys.argv[6].lower()
names = {model.get("name", "") for model in payload.get("models", [])}
for label, model in (("Chat model", chat), ("Deep model", deep)):
    state = "ok" if model and model in names else "missing"
    print(f"{label:<34} {state} ({model or 'unset'})")
if imaging_enabled and imaging_provider == "ollama":
    state = "ok" if imaging and imaging in names else "missing"
    print(f"{'Imaging model':<34} {state} ({imaging or 'unset'})")
PY
  else
    check_line "Ollama" "fail" "${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
    failures=$((failures + 1))
  fi

  if [[ "${KAOSBRAIN_GOVERNOR_TOOLS_ENABLED:-false}" == "true" ]]; then
    local tools_url=${KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL:-}
    if [[ -z "${tools_url}" ]]; then
      check_line "Governor tools" "fail" "missing KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL"
      failures=$((failures + 1))
    else
      local tools_health_payload
      if tools_health_payload=$(curl --fail --silent --show-error "${tools_url%/}/health"); then
        if python3 - "${tools_health_payload}" <<'PY' >/dev/null
import json
import sys

payload = json.loads(sys.argv[1])
if payload.get("status") != "ok" or payload.get("service") != "kaos-governor-tools":
    raise SystemExit(1)
PY
        then
          check_line "Governor tools health" "ok" "${tools_url%/}/health"
        else
          check_line "Governor tools health" "fail" "unexpected response"
          failures=$((failures + 1))
        fi
      else
        check_line "Governor tools health" "fail" "${tools_url%/}/health"
        failures=$((failures + 1))
      fi
      local tools_code
      tools_code=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
        "${tools_url%/}/tools/today?profile=${KAOSBRAIN_GOVERNOR_TOOLS_PROFILE:-main}" || true)
      case "${tools_code}" in
        200|401|403) check_line "Governor tools route" "ok" "http ${tools_code}" ;;
        *) check_line "Governor tools route" "fail" "http ${tools_code:-000}"; failures=$((failures + 1)) ;;
      esac
    fi
  else
    check_line "Governor tools" "disabled"
  fi

  if [[ "${KAOSBRAIN_IMAGING_ENABLED:-false}" == "true" ]]; then
    if [[ "${KAOSBRAIN_IMAGING_PROVIDER:-ollama}" =~ ^(kaosai|kaosbrain-openai)$ ]]; then
      check_line "KaosBrain imaging" "ok" "enabled, provider=kaosbrain-openai, model=${KAOSAI_MODEL:-default}"
    else
      check_line "KaosBrain imaging" "ok" "enabled, provider=ollama, model=${KAOSBRAIN_IMAGING_MODEL:-unset}"
    fi
  else
    check_line "KaosBrain imaging" "disabled"
  fi

  if [[ "${failures}" -gt 0 ]]; then
    die "doctor found ${failures} failing check(s)"
  fi
}

preserve_pre_headless_rollback_artifacts() {
  local old_image_id=$1
  local unit_path=$2
  local unit_existed=$3
  local env_backup="${ENV_FILE}.pre-headless-discord-retirement"
  local unit_backup="${ENV_FILE}.unit.pre-headless-discord-retirement"
  local existing_rollback_image_id
  existing_rollback_image_id=$(docker image inspect "${ROLLBACK_IMAGE_NAME}" --format '{{.Id}}' 2>/dev/null || true)

  if [[ -n "${existing_rollback_image_id}" && "${existing_rollback_image_id}" != "${old_image_id}" ]]; then
    if [[ -L "${env_backup}" || ! -f "${env_backup}" \
      || ( "${unit_existed}" == "true" && ( -L "${unit_backup}" || ! -f "${unit_backup}" ) ) ]]; then
      printf 'ERROR: rollback image tag already points elsewhere and its matching env/unit backups are incomplete: %s\n' "${ROLLBACK_IMAGE_NAME}" >&2
      return 1
    fi
    info "Preserving existing pre-retirement rollback image and env/unit backups."
    return 0
  fi

  if path_exists "${env_backup}" && [[ -L "${env_backup}" || ! -f "${env_backup}" ]]; then
    printf 'ERROR: pre-retirement env backup is not a regular file: %s\n' "${env_backup}" >&2
    return 1
  fi
  if [[ "${unit_existed}" == "true" ]] && path_exists "${unit_backup}" \
    && [[ -L "${unit_backup}" || ! -f "${unit_backup}" ]]; then
    printf 'ERROR: pre-retirement unit backup is not a regular file: %s\n' "${unit_backup}" >&2
    return 1
  fi

  if ! path_exists "${env_backup}"; then
    sudo cp -p "${ENV_FILE}" "${env_backup}" || return 1
    info "Saved permission-preserving pre-retirement env backup: ${env_backup}"
  fi
  if [[ "${unit_existed}" == "true" ]] && ! path_exists "${unit_backup}"; then
    sudo cp -p "${unit_path}" "${unit_backup}" || return 1
    info "Saved permission-preserving pre-retirement unit backup: ${unit_backup}"
  fi
  if [[ -n "${old_image_id}" && -z "${existing_rollback_image_id}" ]]; then
    docker image tag "${old_image_id}" "${ROLLBACK_IMAGE_NAME}" || return 1
    info "Saved pre-retirement image tag: ${ROLLBACK_IMAGE_NAME}"
  fi
}

rollback_headless_cutover() {
  local rollback_dir=$1
  local old_image_id=$2
  local unit_existed=$3
  local service_was_active=$4
  local unit_path="${SYSTEMD_UNIT_DIR}/${SERVICE_NAME}"
  local failures=0

  info "Headless cutover failed; restoring the previous KaosBrain service."
  if [[ "${unit_existed}" == "true" ]] || sudo test -f "${unit_path}"; then
    if ! sudo systemctl stop "${SERVICE_NAME}" >/dev/null 2>&1; then
      printf 'ERROR: failed to stop the failed KaosBrain cutover during rollback\n' >&2
      failures=$((failures + 1))
    fi
  fi
  if ! sudo cp -p "${rollback_dir}/kaosbrain.env" "${ENV_FILE}"; then
    printf 'ERROR: failed to restore KaosBrain env during rollback\n' >&2
    failures=$((failures + 1))
  fi
  if [[ "${unit_existed}" == "true" ]]; then
    if ! sudo cp -p "${rollback_dir}/kaosbrain.service" "${unit_path}"; then
      printf 'ERROR: failed to restore KaosBrain systemd unit during rollback\n' >&2
      failures=$((failures + 1))
    fi
  elif ! sudo rm -f -- "${unit_path}"; then
    printf 'ERROR: failed to remove the newly installed KaosBrain unit during rollback\n' >&2
    failures=$((failures + 1))
  fi

  if [[ -n "${old_image_id}" ]]; then
    if ! docker image tag "${old_image_id}" "${IMAGE_NAME}"; then
      printf 'ERROR: failed to restore the previous KaosBrain image tag\n' >&2
      failures=$((failures + 1))
    fi
  elif docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
    if ! docker image rm "${IMAGE_NAME}" >/dev/null 2>&1; then
      printf 'ERROR: failed to remove the new KaosBrain image tag during rollback\n' >&2
      failures=$((failures + 1))
    fi
  fi

  if ! restore_quarantined_discord_secrets; then
    failures=$((failures + 1))
  fi
  if ! sudo systemctl daemon-reload; then
    printf 'ERROR: failed to reload systemd during KaosBrain rollback\n' >&2
    failures=$((failures + 1))
  fi
  if [[ "${service_was_active}" == "true" ]]; then
    if [[ "${unit_existed}" != "true" ]] || ! sudo systemctl restart "${SERVICE_NAME}"; then
      printf 'ERROR: failed to restart the previous KaosBrain service during rollback\n' >&2
      failures=$((failures + 1))
    fi
  fi
  [[ "${failures}" -eq 0 ]]
}

up() {
  [[ "${CANDIDATE_IMAGE_NAME}" != "${IMAGE_NAME}" ]] \
    || die "KAOSBRAIN_CANDIDATE_IMAGE_NAME must differ from KAOSBRAIN_IMAGE_NAME"
  [[ "${ROLLBACK_IMAGE_NAME}" != "${IMAGE_NAME}" && "${ROLLBACK_IMAGE_NAME}" != "${CANDIDATE_IMAGE_NAME}" ]] \
    || die "KAOSBRAIN_ROLLBACK_IMAGE_NAME must differ from the live and candidate image names"

  # Validate a migrated copy and build a separate image tag before touching the
  # live env, unit, image tag, secrets, or running service.
  prospective_preflight
  load_env
  validate_retired_discord_secret_quarantine
  build_image "${CANDIDATE_IMAGE_NAME}"

  local rollback_dir
  rollback_dir=$(mktemp -d)
  chmod 0700 "${rollback_dir}"
  local unit_path="${SYSTEMD_UNIT_DIR}/${SERVICE_NAME}"
  local unit_existed=false
  local service_was_active=false
  local old_image_id
  old_image_id=$(docker image inspect "${IMAGE_NAME}" --format '{{.Id}}' 2>/dev/null || true)
  if sudo test -f "${unit_path}"; then
    unit_existed=true
  fi
  if sudo systemctl is-active --quiet "${SERVICE_NAME}"; then
    service_was_active=true
  fi
  if ! sudo cp -p "${ENV_FILE}" "${rollback_dir}/kaosbrain.env"; then
    sudo rm -rf -- "${rollback_dir}"
    die "failed to snapshot the live KaosBrain deployment before cutover"
  fi
  if [[ "${unit_existed}" == "true" ]] \
    && ! sudo cp -p "${unit_path}" "${rollback_dir}/kaosbrain.service"; then
    sudo rm -rf -- "${rollback_dir}"
    die "failed to snapshot the live KaosBrain systemd unit before cutover"
  fi
  if ! preserve_pre_headless_rollback_artifacts "${old_image_id}" "${unit_path}" "${unit_existed}"; then
    sudo rm -rf -- "${rollback_dir}"
    die "failed to preserve persistent pre-retirement rollback artifacts"
  fi

  local cutover_status
  set +e
  (
    set -e
    ensure_upgrade_defaults
    preflight
    docker image tag "${CANDIDATE_IMAGE_NAME}" "${IMAGE_NAME}"
    install_service_unit
    sudo systemctl daemon-reload
  )
  cutover_status=$?
  set -e
  if [[ "${cutover_status}" -eq 0 ]]; then
    if ! quarantine_retired_discord_secrets; then
      cutover_status=1
    fi
  fi
  if [[ "${cutover_status}" -eq 0 ]]; then
    set +e
    (
      set -e
      load_env
      sudo systemctl restart "${SERVICE_NAME}"
      smoke
    )
    cutover_status=$?
    set -e
  fi

  if [[ "${cutover_status}" -ne 0 ]]; then
    if rollback_headless_cutover "${rollback_dir}" "${old_image_id}" "${unit_existed}" "${service_was_active}"; then
      sudo rm -rf -- "${rollback_dir}"
      die "KaosBrain headless cutover failed; the previous deployment was restored"
    fi
    printf 'ERROR: KaosBrain cutover and automatic rollback both failed; recovery snapshot retained at %s\n' "${rollback_dir}" >&2
    return 1
  fi

  sudo rm -rf -- "${rollback_dir}"
  docker image rm "${CANDIDATE_IMAGE_NAME}" >/dev/null 2>&1 || true
  info "KaosBrain headless cutover completed and passed authenticated smoke checks."
}

deploy() {
  require_command git
  git -C "${REPO_ROOT}" pull --ff-only origin main
  up
}

status() {
  sudo systemctl status "${SERVICE_NAME}" --no-pager
  docker ps --filter "name=${CONTAINER_NAME}" --format '{{.Names}} {{.Image}} {{.Status}}'
}

openclaw_reauth() {
  load_openclaw_cli
  export_openclaw_env
  [[ -f "${OPENCLAW_CONFIG_PATH}" ]] || die "missing OpenClaw config: ${OPENCLAW_CONFIG_PATH}"
  info "Starting OpenClaw OpenAI reauth for ${OPENCLAW_CONFIG_PATH}"
  info "Open the device-pairing URL and enter the displayed one-time code."
  openclaw models auth login --provider openai --method device-code --force
  if systemctl --user list-unit-files "${OPENCLAW_GATEWAY_SERVICE}" >/dev/null 2>&1; then
    systemctl --user restart "${OPENCLAW_GATEWAY_SERVICE}"
    info "Restarted ${OPENCLAW_GATEWAY_SERVICE}"
  else
    info "OpenClaw auth updated. Restart the OpenClaw gateway manually if it is running outside systemd."
  fi
  openclaw models auth list
}

openclaw_reauth_agent_setup() {
  require_command python3
  require_command systemctl
  install -d -m 0750 "${CANONICAL_SECRETS_DIR}" "$(dirname "${REAUTH_AGENT_ENV_FILE}")" "${HOME}/.config/systemd/user"
  if [[ ! -s "${REAUTH_AGENT_TOKEN_FILE}" ]]; then
    if command -v openssl >/dev/null 2>&1; then
      openssl rand -hex 32 >"${REAUTH_AGENT_TOKEN_FILE}"
    else
      python3 - <<'PY' >"${REAUTH_AGENT_TOKEN_FILE}"
import secrets
print(secrets.token_hex(32))
PY
    fi
  fi
  chmod 0640 "${REAUTH_AGENT_TOKEN_FILE}"
  if [[ ! -f "${REAUTH_AGENT_ENV_FILE}" ]]; then
    cat >"${REAUTH_AGENT_ENV_FILE}" <<EOF
KAOSAI_REAUTH_TOKEN_FILE=${REAUTH_AGENT_TOKEN_FILE}
KAOSAI_REAUTH_HOST=127.0.0.1
KAOSAI_REAUTH_PORT=18997
KAOSAI_OPENCLAW_STATE_DIR=${OPENCLAW_STATE_DIR}
KAOSAI_OPENCLAW_CONFIG_PATH=${OPENCLAW_CONFIG_PATH}
KAOSAI_OPENCLAW_GATEWAY_SERVICE=${OPENCLAW_GATEWAY_SERVICE}
KAOSAI_OPENCLAW_NVM_SH=${HOME}/.nvm/nvm.sh
KAOSAI_OPENCLAW_NODE_VERSION=24
EOF
    chmod 0640 "${REAUTH_AGENT_ENV_FILE}"
  fi
  python3 -m venv "${REAUTH_AGENT_VENV_DIR}"
  "${REAUTH_AGENT_VENV_DIR}/bin/python" -m pip install --upgrade pip >/dev/null
  "${REAUTH_AGENT_VENV_DIR}/bin/python" -m pip install "${REPO_ROOT}/apps/brain" >/dev/null
  rm -rf "${REPO_ROOT}/apps/brain/build" "${REPO_ROOT}/apps/brain/src/kaos_brain.egg-info"
  sed \
    -e "s/__ENV_FILE__/$(sed_escape "${REAUTH_AGENT_ENV_FILE}")/g" \
    -e "s/__VENV_DIR__/$(sed_escape "${REAUTH_AGENT_VENV_DIR}")/g" \
    "${DEPLOY_DIR}/openclaw-reauth-agent.service" >"${HOME}/.config/systemd/user/${REAUTH_AGENT_SERVICE_NAME}"
  systemctl --user daemon-reload
  systemctl --user enable "${REAUTH_AGENT_SERVICE_NAME}" >/dev/null
  info "OpenClaw reauth agent setup complete."
  info "Start it with: ${0} openclaw-reauth-agent-up"
}

openclaw_reauth_agent_up() {
  systemctl --user restart "${REAUTH_AGENT_SERVICE_NAME}"
  sleep 1
  systemctl --user is-active "${REAUTH_AGENT_SERVICE_NAME}" >/dev/null
  info "OpenClaw reauth agent is active."
}

openclaw_reauth_agent_status() {
  systemctl --user status "${REAUTH_AGENT_SERVICE_NAME}" --no-pager
}

logs() {
  docker logs --tail "${1:-120}" "${CONTAINER_NAME}"
}

usage() {
  cat <<EOF
Usage: ${0} <command>

Commands:
  setup      Create env/secret paths and install the systemd unit
  preflight  Validate host, env, secret, and Ollama reachability
  test       Build and run the Brain test image
  build      Build the runtime image
  up         Run preflight, build, restart, and smoke check
  deploy     git pull --ff-only origin main, then up
  doctor     Check the headless Brain API, Ollama, and Governor tools
  status     Show systemd and container status
  openclaw-reauth
             Renew the OpenClaw OpenAI/ChatGPT login and restart the OpenClaw gateway
  openclaw-reauth-agent-setup
             Install the H4-local token-protected OpenClaw reauth HTTP agent
  openclaw-reauth-agent-up
             Restart the H4-local OpenClaw reauth HTTP agent
  openclaw-reauth-agent-status
             Show the H4-local OpenClaw reauth HTTP agent status
  logs [n]   Show recent container logs
EOF
}

case "${1:-}" in
  setup) setup ;;
  preflight) preflight ;;
  test) test_image ;;
  build) build_image ;;
  up) up ;;
  deploy) deploy ;;
  doctor) doctor ;;
  status) status ;;
  openclaw-reauth) openclaw_reauth ;;
  openclaw-reauth-agent-setup) openclaw_reauth_agent_setup ;;
  openclaw-reauth-agent-up) openclaw_reauth_agent_up ;;
  openclaw-reauth-agent-status) openclaw_reauth_agent_status ;;
  logs) shift; logs "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1" ;;
esac
