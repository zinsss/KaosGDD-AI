[Unit]
Description=KaosAI OpenClaw reauth agent
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__ENV_FILE__
ExecStart=__VENV_DIR__/bin/kaos-openclaw-reauth-agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
