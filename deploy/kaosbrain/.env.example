KAOS_HOST_UID=1000
KAOS_HOST_GID=1000

OLLAMA_BASE_URL=http://127.0.0.1:11434
KAOSBRAIN_CHAT_MODEL=gemma3:4b
KAOSBRAIN_DEEP_MODEL=qwen3:8b
# For KaosPACS-AIO second-look through OpenClaw/ChatGPT, set provider=kaosai
# and enable KAOSAI_* below. Keep ollama for local-only imaging fallback.
KAOSBRAIN_IMAGING_PROVIDER=ollama
KAOSBRAIN_IMAGING_MODEL=gemma3:4b
KAOSBRAIN_REQUEST_TIMEOUT_SECONDS=180
KAOSAI_ENABLED=false
KAOSAI_PROVIDER=disabled
KAOSAI_BASE_URL=
KAOSAI_MODEL=default
KAOSAI_API_TOKEN_FILE=
KAOSAI_TIMEOUT_SECONDS=30
KAOSAI_REAUTH_ENABLED=false
KAOSAI_REAUTH_BASE_URL=http://127.0.0.1:18997
KAOSAI_REAUTH_TOKEN_FILE=/run/secrets/kaosai_reauth_agent_token
KAOSAI_REAUTH_TIMEOUT_SECONDS=60
KAOSBRAIN_GOVERNOR_TOOLS_ENABLED=false
KAOSBRAIN_GOVERNOR_TOOLS_BASE_URL=
KAOSBRAIN_GOVERNOR_TOOLS_PROFILE=main
KAOSBRAIN_GOVERNOR_TOOLS_TIMEOUT_SECONDS=10
KAOSBRAIN_IMAGING_ENABLED=false
KAOSBRAIN_IMAGING_API_TOKEN_FILE=/run/secrets/governor_api_token
KAOSBRAIN_CALENDAR_PREVIEW_API_TOKEN_FILE=/run/secrets/governor_api_token
KAOSBRAIN_DOCUMENT_TAG_API_TOKEN_FILE=/run/secrets/governor_api_token
KAOSBRAIN_AI_TASK_API_TOKEN_FILE=/run/secrets/governor_api_token
# Optional: direct OpenAI API backend for AI Tasks WEB SEARCH.
# If unset, KaosBrain can fall back to OpenClaw/OAuth when tools.web.search is enabled.
KAOSBRAIN_OPENAI_API_KEY_FILE=
KAOSBRAIN_WEB_TASK_MODEL=gpt-5.6
KAOSBRAIN_WEB_TASK_TIMEOUT_SECONDS=90
KAOSBRAIN_MEMOS_PUBLIC_URL=
KAOSBRAIN_PAPERLESS_PUBLIC_URL=
# The headless API is always enabled. Bind to loopback or the H4 Tailscale IP.
KAOSBRAIN_HEALTH_HOST=127.0.0.1
KAOSBRAIN_HEALTH_PORT=8099
GOVERNOR_API_TOKEN_FILE=/run/secrets/governor_api_token
LOG_LEVEL=INFO
