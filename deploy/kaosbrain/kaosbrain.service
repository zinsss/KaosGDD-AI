[Unit]
Description=KaosBrain Discord service
Requires=docker.service
After=docker.service network-online.target ollama.service
Wants=network-online.target
ConditionPathExists=/srv/kaos/secrets/kaosbrain_discord_bot_token

[Service]
Type=simple
EnvironmentFile=/srv/kaos/brain/kaosbrain.env
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f kaos-brain
ExecStart=/usr/bin/docker run --rm --name kaos-brain --network host --user ${KAOS_HOST_UID}:${KAOS_HOST_GID} --env-file /srv/kaos/brain/kaosbrain.env --mount type=bind,src=/srv/kaos/secrets,dst=/run/secrets,ro kaos-brain:current
ExecStop=/usr/bin/docker stop kaos-brain

[Install]
WantedBy=multi-user.target
