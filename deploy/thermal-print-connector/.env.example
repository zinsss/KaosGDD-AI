# Bind to this host's Tailscale address when Governor should reach it.
THERMAL_CONNECTOR_HOST=127.0.0.1
THERMAL_CONNECTOR_PORT=8100
THERMAL_CONNECTOR_HOST_GID=1000

# Keep dry-run until the 80 mm queue exists and `lpstat -p` succeeds.
THERMAL_CONNECTOR_MODE=dry-run
THERMAL_CONNECTOR_PRINTER=
# Use `escpos` with a raw CUPS queue for EPSON-compatible receipt printers.
THERMAL_CONNECTOR_OUTPUT_FORMAT=pdf
THERMAL_CONNECTOR_RASTER_DPI=180
THERMAL_CONNECTOR_RASTER_WIDTH=512
# Slightly darkens antialiased glyph edges before the 1-bit thermal raster.
THERMAL_CONNECTOR_RASTER_THRESHOLD=168
# Photo jobs are dithered once, only after their PDF reaches native resolution.
THERMAL_CONNECTOR_PHOTO_THRESHOLD=128
THERMAL_CONNECTOR_TOKEN_FILE=/run/secrets/thermal_connector_token
THERMAL_CONNECTOR_STATE_PATH=/data/connector/jobs.json
THERMAL_CONNECTOR_MAX_PDF_MB=8

# With host networking, the container reaches host CUPS on localhost:631.
CUPS_SERVER=127.0.0.1:631
