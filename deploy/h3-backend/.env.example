KAOS_ROOT=/srv/kaos
GOVERNOR_STATE_ROOT=/srv/kaosgdd/kaosgovernor
KAOS_HOST_GID=1000
GOVERNOR_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
EDGE_BIND_ADDRESS=127.0.0.1

DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
DISCORD_GUILD_ID=123456789012345678
DISCORD_ALLOWED_USER_IDS=123456789012345678
DISCORD_ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789
DISCORD_SYSTEM_CHANNEL_ID=234567890123456789
DISCORD_STARTUP_NOTIFICATION=false
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8097
GOVERNOR_BRAIN_TOOLS_ENABLED=false
GOVERNOR_BRAIN_TOOLS_HOST=0.0.0.0
GOVERNOR_BRAIN_TOOLS_BIND_ADDRESS=127.0.0.1
GOVERNOR_BRAIN_TOOLS_PORT=8098
GOVERNOR_API_INTERNAL_URL=http://governor-api:8096
LOG_LEVEL=INFO

DISCORD_CALENDAR_ENABLED=false
DISCORD_CALENDAR_CHANNEL_ID=
DISCORD_CALENDAR_PROFILE=main
DISCORD_CALENDAR_STATE_PATH=/data/discord-calendar/state.json
CALENDAR_ADAPTER_INTERNAL_URL=http://calendar-adapter:8091
DISCORD_TASKS_ENABLED=false
DISCORD_TASKS_CHANNEL_ID=
DISCORD_TASKS_PROFILE=main
DISCORD_TASKS_STATE_PATH=/data/discord-tasks/state.json
DISCORD_TASKS_REFRESH_SECONDS=60
DISCORD_SUPPLIES_ENABLED=false
DISCORD_SUPPLIES_CHANNEL_ID=
DISCORD_SUPPLIES_PROFILE=main
DISCORD_SUPPLIES_STATE_PATH=/data/discord-supplies/state.json
DISCORD_SUPPLIES_COLLECTION_ID=
DISCORD_MEMOS_ENABLED=false
DISCORD_MEMOS_CHANNEL_ID=
DISCORD_INBOX_ENABLED=false
DISCORD_INBOX_CHANNEL_ID=
DISCORD_INBOX_STATE_PATH=/data/discord-inbox/state.json
DISCORD_SERVICE_STATUS_ENABLED=false
DISCORD_SERVICE_STATUS_CHANNEL_ID=
DISCORD_SERVICE_STATUS_STATE_PATH=/data/discord-system/status.json
SERVICE_STATUS_REFRESH_SECONDS=300
SERVICE_STATUS_TIMEOUT_SECONDS=3
SERVICE_STATUS_DEFAULT_PROBES_ENABLED=true
SERVICE_STATUS_RESTART_ALLOWED_KEYS=
SERVICE_STATUS_RESTART_MODE=dry_run
SERVICE_STATUS_RESTART_TIMEOUT_SECONDS=30
# Restart commands are ignored unless the service key is listed above. The
# default mode records a dry-run only; set SERVICE_STATUS_RESTART_MODE=execute
# after validating the allowlist and command for each service.
# Example:
# SERVICE_STATUS_MEMOS_RESTART_COMMAND=docker compose --project-directory /srv/kaos/stacks/backends restart memos
# Built-in Docker-network HTTP probes cover KaosGovernor, Radicale, Memos, and
# Vaultwarden. Use explicit URLs/TCP probes for services that live outside the
# Governor Docker network or still run on Office Kaos.
SERVICE_STATUS_KAOSBRAIN_URL=
# Office Kaos KaosPACS web health is usually http://<office-tailscale-ip>:8070/health.
SERVICE_STATUS_KAOSPACS_URL=
SERVICE_STATUS_KAOSINJ_URL=
SERVICE_STATUS_PAPERLESS_URL=
# Office Kaos Stirling-PDF is usually http://<office-tailscale-ip>:8082/.
SERVICE_STATUS_STIRLINGPDF_URL=
# Office Kaos RustDesk relay TCP is usually <office-tailscale-ip>:21117.
SERVICE_STATUS_RUSTDESK_TCP=

# KaosBrain receives only this bearer token. It never receives the Memos PAT.
GOVERNOR_API_TOKEN_FILE=/run/secrets/governor_api_token
MEMOS_SEARCH_ENABLED=false
MEMOS_BASE_URL=http://memos:5230
MEMOS_ACCESS_TOKEN_FILE=/run/secrets/memos_access_token
MEMOS_CREATOR=users/zin
MEMOS_TIMEOUT_SECONDS=15
MEMOS_SEARCH_MAX_RESULTS=20
PAPERLESS_BASE_URL=
PAPERLESS_PUBLIC_URL=
PAPERLESS_API_TOKEN_FILE=/run/secrets/paperless_api_token
PAPERLESS_INBOX_MAX_ATTACHMENT_MB=20
PAPERLESS_TIMEOUT_SECONDS=60

MAIL_NAVER_ENABLED=false
MAIL_NAVER_HOST=imap.naver.com
MAIL_NAVER_PORT=993
MAIL_NAVER_USERNAME=
MAIL_NAVER_PASSWORD_FILE=/run/secrets/naver_mail_password
MAIL_NAVER_FOLDERS=세무사,영덕군보건소
MAIL_NAVER_STATE_PATH=/data/mail/naver-discord.json
MAIL_NAVER_POLL_SECONDS=60
MAIL_NAVER_TIMEOUT_SECONDS=20
MAIL_NAVER_MAX_ATTACHMENT_MB=20
MAIL_NAVER_PREVIEW_CHARS=2200
MAIL_NAVER_MARK_EXISTING_ON_FIRST_RUN=true
MAIL_ARCHIVE_DISCORD_CHANNEL_ID=
MAIL_ORGANIZER_DISCORD_CHANNEL_ID=
MAIL_ORGANIZER_ENABLED=false
MAIL_ORGANIZER_STATE_PATH=/data/mail/discord-organizer.json
MAIL_ORGANIZER_MAX_ITEMS=30
MAIL_ORGANIZER_SCHEDULER_POLL_SECONDS=60
MAIL_ORGANIZER_TRASH_FOLDER="Deleted Messages"
MAIL_ORGANIZER_RUNS_PER_DAY=1
MAIL_ORGANIZER_FIRST_TIME=09:00
MAIL_ORGANIZER_SECOND_TIME=17:00
MAIL_ORGANIZER_DIGEST_TTL_DAYS=14

# Fax transport remains on Office Kaos. Leave disabled on the H3 backend until
# the authenticated office Fax Connector is deployed and verified.
FAX_DISCORD_ENABLED=false
FAX_DISCORD_MESSAGE_INTAKE=false
FAX_ARCHIVE_DISCORD_CHANNEL_ID=
FAX_NOTIFICATION_DISCORD_CHANNEL_ID=
FAX_DISCORD_STATE_PATH=/data/fax/state.json
FAX_TRANSPORT=connector
FAX_CONNECTOR_BASE_URL=
FAX_CONNECTOR_TOKEN_FILE=/run/secrets/fax_connector_token
FAX_CONNECTOR_TIMEOUT_SECONDS=20
FAX_OUTGOING_QUEUE_ROOT=/integrations/fax-outgoing
FAX_LEGACY_OUTGOING_STATE_PATH=/integrations/fax-outgoing/state.json
FAX_HYLAFAX_RECVQ=/integrations/hylafax/recvq
FAX_HYLAFAX_XFERFAXLOG=/integrations/hylafax/log/xferfaxlog
FAX_HYLAFAX_DONEQ=/integrations/hylafax/doneq
FAX_DISCORD_POLL_SECONDS=20
FAX_MIN_FILE_AGE_SECONDS=60
FAX_MAX_PDF_MB=20
FAX_MARK_EXISTING_ON_FIRST_RUN=true
FAX_DELETE_DISCORD_SOURCE_ON_SUCCESS=true
