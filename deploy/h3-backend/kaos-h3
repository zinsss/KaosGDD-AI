#!/usr/bin/env bash
set -euo pipefail

DEPLOY_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${DEPLOY_DIR}/../.." && pwd)
ENV_FILE="${DEPLOY_DIR}/.env"
SECRETS_DIR="${DEPLOY_DIR}/secrets"
COMPOSE=(docker compose --project-directory "${DEPLOY_DIR}" --env-file "${ENV_FILE}" -f "${DEPLOY_DIR}/compose.yaml")
BACKENDS_COMPOSE=("${COMPOSE[@]}" -f "${DEPLOY_DIR}/compose.backends.yaml")
SERVICES_COMPOSE=("${COMPOSE[@]}" -f "${DEPLOY_DIR}/compose.services.yaml")
EDGE_COMPOSE=("${COMPOSE[@]}" -f "${DEPLOY_DIR}/compose.edge.yaml")

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

load_env() {
  [[ -f "${ENV_FILE}" ]] || die "run: ${0} setup"
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
}

secret_path() {
  printf '%s/%s' "${SECRETS_DIR}" "$1"
}

require_secret() {
  local name=$1
  [[ -s "$(secret_path "${name}")" ]] || die "missing secret: ${SECRETS_DIR}/${name}"
}

sudo_test_path() {
  local predicate=$1
  local path=$2
  command -v sudo >/dev/null 2>&1 && sudo -n test "${predicate}" "${path}" 2>/dev/null
}

require_path() {
  local path=$1
  [[ -e "${path}" ]] || sudo_test_path -e "${path}" || die "missing required path: ${path}"
}

require_file() {
  local path=$1
  [[ -f "${path}" ]] || sudo_test_path -f "${path}" || die "missing required file: ${path}"
}

require_nonempty_file() {
  local path=$1
  [[ -s "${path}" ]] || sudo_test_path -s "${path}" || die "missing or empty required file: ${path}"
}

require_dir() {
  local path=$1
  [[ -d "${path}" ]] || sudo_test_path -d "${path}" || die "missing required directory: ${path}"
}

require_sqlite_ok() {
  local path=$1
  require_command sqlite3
  require_file "${path}"
  [[ "$(sqlite3 "${path}" 'PRAGMA integrity_check;')" == "ok" ]] \
    || die "SQLite integrity check failed: ${path}"
}

redact_config() {
  awk '
    BEGIN { IGNORECASE = 1 }
    /^[[:space:]]+[A-Z0-9_]*(TOKEN|PASSWORD|SECRET|KEY|AUD|CREDENTIAL|COOKIE|SALT|ENCRYPTION)[A-Z0-9_]*:/ {
      sub(/:.*/, ": [redacted]")
    }
    /^[[:space:]]+- [A-Z0-9_]*(TOKEN|PASSWORD|SECRET|KEY|AUD|CREDENTIAL|COOKIE|SALT|ENCRYPTION)[A-Z0-9_]*=/ {
      sub(/=.*/, "=[redacted]")
    }
    { print }
  '
}

install_state_directories() {
  local root=$1
  local uid gid
  uid=$(id -u)
  gid=$(id -g)
  if mkdir -p \
    "${root}/mail" \
    "${root}/fax" \
    "${root}/discord-calendar" \
    "${root}/discord-tasks" \
    "${root}/discord-supplies" \
    "${root}/discord-inbox" \
    "${root}/discord-system" \
    "${root}/documents" \
    "${root}/notifications" 2>/dev/null; then
    chmod 0770 \
      "${root}/mail" \
      "${root}/fax" \
      "${root}/discord-calendar" \
      "${root}/discord-tasks" \
      "${root}/discord-supplies" \
      "${root}/discord-inbox" \
      "${root}/discord-system" \
      "${root}/documents" \
      "${root}/notifications"
    return
  fi
  require_command sudo
  sudo install -d -m 0770 -o "${uid}" -g "${gid}" \
    "${root}/mail" \
    "${root}/fax" \
    "${root}/discord-calendar" \
    "${root}/discord-tasks" \
    "${root}/discord-supplies" \
    "${root}/discord-inbox" \
    "${root}/discord-system" \
    "${root}/documents" \
    "${root}/notifications"
}

governor_state_root() {
  if [[ -n "${GOVERNOR_STATE_ROOT:-}" ]]; then
    printf '%s' "${GOVERNOR_STATE_ROOT}"
    return
  fi
  printf '%s/data/kaosgdd-ai/governor' "${KAOS_ROOT:-/srv/kaos}"
}

setup() {
  require_command docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  require_command openssl
  mkdir -p "${SECRETS_DIR}"
  if [[ ! -f "${ENV_FILE}" ]]; then
    cp "${DEPLOY_DIR}/.env.example" "${ENV_FILE}"
    sed -i "s/^KAOS_HOST_GID=.*/KAOS_HOST_GID=$(id -g)/" "${ENV_FILE}"
    info "Created ${ENV_FILE}"
  fi
  load_env
  install_state_directories "$(governor_state_root)"
  for secret in \
    discord_bot_token \
    memos_access_token \
    naver_mail_password \
    paperless_api_token \
    fax_connector_token \
    pushover_app_token \
    pushover_user_key; do
    [[ -e "$(secret_path "${secret}")" ]] || : > "$(secret_path "${secret}")"
  done
  if [[ ! -s "$(secret_path governor_api_token)" ]]; then
    openssl rand -hex 32 > "$(secret_path governor_api_token)"
  fi
  if [[ ! -s "$(secret_path ios_shortcuts_token)" ]]; then
    openssl rand -hex 32 > "$(secret_path ios_shortcuts_token)"
  fi
  chmod 0640 "${SECRETS_DIR}"/discord_bot_token \
    "${SECRETS_DIR}"/governor_api_token \
    "${SECRETS_DIR}"/ios_shortcuts_token \
    "${SECRETS_DIR}"/memos_access_token \
    "${SECRETS_DIR}"/naver_mail_password \
    "${SECRETS_DIR}"/paperless_api_token \
    "${SECRETS_DIR}"/fax_connector_token \
    "${SECRETS_DIR}"/pushover_app_token \
    "${SECRETS_DIR}"/pushover_user_key
  info "Setup complete. Fill ${ENV_FILE} and ${SECRETS_DIR}/discord_bot_token, then run:"
  info "  ${0} test"
  info "  ${0} up"
}

preflight() {
  require_command docker
  require_command curl
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  load_env
  require_secret discord_bot_token
  require_secret governor_api_token
  if [[ "${GOVERNOR_OPERATION_STORE:-postgres}" == "postgres" ]]; then
    require_nonempty_file "${KAOS_ROOT:-/srv/kaos}/secrets/governor-postgres.env"
  fi
  if [[ "${GOVERNOR_BRAIN_TOOLS_ENABLED:-false}" == "true" ]]; then
    require_secret ios_shortcuts_token
  fi
  [[ "${DISCORD_GUILD_ID:-}" != "123456789012345678" ]] || die "replace the example Discord guild ID"
  [[ "${DISCORD_ALLOWED_USER_IDS:-}" != *"123456789012345678"* ]] || die "replace the example Discord user ID"
  [[ "${DISCORD_ALLOWED_CHANNEL_IDS:-}" != *"123456789012345678"* ]] || die "replace the example Discord channel IDs"
  if [[ "${MEMOS_SEARCH_ENABLED:-false}" == "true" ]]; then
    require_secret memos_access_token
    [[ -n "${MEMOS_BASE_URL:-}" ]] || die "MEMOS_BASE_URL is required"
    [[ "${MEMOS_CREATOR:-}" == users/* ]] || die "MEMOS_CREATOR must use users/<username>"
  fi
  if [[ "${MAIL_NAVER_ENABLED:-false}" == "true" || "${MAIL_ORGANIZER_ENABLED:-false}" == "true" ]]; then
    require_secret naver_mail_password
    [[ -n "${MAIL_NAVER_USERNAME:-}" ]] || die "MAIL_NAVER_USERNAME is required"
    if [[ "${MAIL_NAVER_OWNER:-discord}" == "discord" || "${MAIL_ORGANIZER_ENABLED:-false}" == "true" ]]; then
      [[ -n "${MAIL_ARCHIVE_DISCORD_CHANNEL_ID:-}" ]] || die "MAIL_ARCHIVE_DISCORD_CHANNEL_ID is required"
    fi
  fi
  if [[ "${MAIL_ORGANIZER_ENABLED:-false}" == "true" ]]; then
    [[ -n "${MAIL_ORGANIZER_DISCORD_CHANNEL_ID:-}" ]] || die "MAIL_ORGANIZER_DISCORD_CHANNEL_ID is required"
  fi
  if [[ "${DISCORD_CALENDAR_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_CALENDAR_CHANNEL_ID:-}" ]] || die "DISCORD_CALENDAR_CHANNEL_ID is required"
    [[ -n "${CALENDAR_ADAPTER_INTERNAL_URL:-}" ]] || die "CALENDAR_ADAPTER_INTERNAL_URL is required"
  fi
  if [[ "${DISCORD_TASKS_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_TASKS_CHANNEL_ID:-}" ]] || die "DISCORD_TASKS_CHANNEL_ID is required"
    [[ -n "${CALENDAR_ADAPTER_INTERNAL_URL:-}" ]] || die "CALENDAR_ADAPTER_INTERNAL_URL is required"
  fi
  if [[ "${DISCORD_SUPPLIES_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_SUPPLIES_CHANNEL_ID:-}" ]] || die "DISCORD_SUPPLIES_CHANNEL_ID is required"
    [[ -n "${CALENDAR_ADAPTER_INTERNAL_URL:-}" ]] || die "CALENDAR_ADAPTER_INTERNAL_URL is required"
  fi
  if [[ "${DISCORD_INBOX_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_INBOX_CHANNEL_ID:-}" ]] || die "DISCORD_INBOX_CHANNEL_ID is required"
    [[ -n "${PAPERLESS_BASE_URL:-${PAPERLESS_INTERNAL_URL:-}}" ]] || die "PAPERLESS_BASE_URL is required"
    require_secret paperless_api_token
  fi
  if [[ "${FAX_DISCORD_ENABLED:-false}" == "true" ]]; then
    [[ "${FAX_TRANSPORT:-connector}" == "connector" ]] \
      || die "H3 fax must use FAX_TRANSPORT=connector; HylaFAX stays on Office Kaos"
    [[ -n "${FAX_CONNECTOR_BASE_URL:-}" ]] || die "FAX_CONNECTOR_BASE_URL is required when fax is enabled"
    require_secret fax_connector_token
  fi
  if [[ "${PUSHOVER_ENABLED:-false}" == "true" ]]; then
    require_secret pushover_app_token
    require_secret pushover_user_key
  fi
  case "${PUSHOVER_DELIVERY_MODE:-worker}" in
    inline|worker) ;;
    *) die "PUSHOVER_DELIVERY_MODE must be inline or worker" ;;
  esac
  case "${MAIL_NAVER_OWNER:-discord}" in
    discord|worker) ;;
    *) die "MAIL_NAVER_OWNER must be discord or worker" ;;
  esac
  case "${FAX_LIFECYCLE_OWNER:-discord}" in
    discord|worker) ;;
    *) die "FAX_LIFECYCLE_OWNER must be discord or worker" ;;
  esac
  case "${DAILY_DIGEST_OWNER:-discord}" in
    discord|worker) ;;
    *) die "DAILY_DIGEST_OWNER must be discord or worker" ;;
  esac
  if [[ "${MAIL_NAVER_OWNER:-discord}" == "worker" || "${FAX_LIFECYCLE_OWNER:-discord}" == "worker" ]]; then
    [[ "${PUSHOVER_DELIVERY_MODE:-worker}" == "worker" ]] \
      || die "PUSHOVER_DELIVERY_MODE must be worker for worker-owned mail or fax polling"
  fi
  if [[ "${DAILY_DIGEST_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_SYSTEM_CHANNEL_ID:-}" ]] \
      || die "DISCORD_SYSTEM_CHANNEL_ID is required when the daily digest is enabled"
    [[ -n "${CALENDAR_ADAPTER_INTERNAL_URL:-}" ]] \
      || die "CALENDAR_ADAPTER_INTERNAL_URL is required when the daily digest is enabled"
  fi
  "${COMPOSE[@]}" config --quiet
  info "Preflight passed."
}

test_image() {
  require_command docker
  docker build --target test \
    --tag kaosgdd-ai-governor-discord:test \
    --file "${REPO_ROOT}/integrations/discoord/Dockerfile" \
    "${REPO_ROOT}"
  docker run --rm kaosgdd-ai-governor-discord:test
}

wait_worker_healthy() {
  local attempt worker_status=""
  for attempt in $(seq 1 30); do
    worker_status=$(docker inspect --format '{{.State.Health.Status}}' kaos-governor-worker 2>/dev/null || true)
    [[ "${worker_status}" == "healthy" ]] && return
    sleep 1
  done
  "${COMPOSE[@]}" logs --tail=80 governor-worker >&2 || true
  die "Governor worker did not become healthy"
}

smoke() {
  load_env
  local address=${GOVERNOR_BIND_ADDRESS:-127.0.0.1}
  [[ "${address}" != "0.0.0.0" ]] || address=127.0.0.1
  local health_url="http://${address}:${HEALTH_PORT:-8097}/health"
  local ready_url="http://${address}:${HEALTH_PORT:-8097}/ready"
  local attempt
  for attempt in $(seq 1 30); do
    if curl --fail --silent --show-error "${health_url}" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  if ! curl --fail --silent --show-error "${health_url}" >/dev/null 2>&1; then
    "${COMPOSE[@]}" logs --tail=80 governor-discord >&2 || true
    die "Governor health endpoint did not become available: ${health_url}"
  fi
  for attempt in $(seq 1 60); do
    if curl --fail --silent --show-error "${ready_url}" >/dev/null 2>&1; then
      curl --fail --silent --show-error "${ready_url}"
      printf '\n'
      if [[ "${PUSHOVER_DELIVERY_MODE:-worker}" == "worker" ]]; then
        wait_worker_healthy
      fi
      return
    fi
    sleep 1
  done
  "${COMPOSE[@]}" logs --tail=80 governor-discord >&2 || true
  die "Governor ready endpoint did not become ready: ${ready_url}"
}

up_runtime() {
  local recreate=$1
  local recreate_options=()
  if [[ "${recreate}" == "true" ]]; then
    recreate_options+=(--force-recreate)
  fi
  if [[ "${PUSHOVER_DELIVERY_MODE:-worker}" == "worker" ]]; then
    "${COMPOSE[@]}" build governor-discord governor-worker
    "${COMPOSE[@]}" stop governor-discord >/dev/null 2>&1 || true
    "${COMPOSE[@]}" up --detach "${recreate_options[@]}" governor-worker
    wait_worker_healthy
    "${COMPOSE[@]}" up --detach "${recreate_options[@]}" governor-discord
  else
    "${COMPOSE[@]}" stop governor-worker >/dev/null 2>&1 || true
    "${COMPOSE[@]}" up --detach --build "${recreate_options[@]}" governor-discord
  fi
}

maintenance_report() {
  load_env
  require_command python3
  local root report_path targets timeout
  root=$(governor_state_root)
  install_state_directories "${root}"
  report_path="${root}/discord-system/maintenance.json"
  targets="${SYSTEM_MAINTENANCE_TARGETS:-kaosgdd=local:/srv/projects/KaosGDD-AI,kaosbrain=ssh:zin@kaosbrain:/srv/projects/KaosGDD-AI,kaosclinic=ssh:zin@kaosclinic:}"
  timeout="${SYSTEM_MAINTENANCE_TIMEOUT_SECONDS:-12}"
  python3 - "${report_path}" "${targets}" "${timeout}" <<'PY'
import json
import os
import shlex
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

report_path, raw_targets, raw_timeout = sys.argv[1:4]
try:
    timeout = min(max(float(raw_timeout), 3.0), 60.0)
except ValueError:
    timeout = 12.0


def parse_targets(raw):
    targets = []
    for part in raw.split(","):
        entry = part.strip()
        if not entry or "=" not in entry:
            continue
        name, spec = entry.split("=", 1)
        mode, _, remainder = spec.partition(":")
        if mode == "local":
            targets.append({"name": name.strip(), "mode": "local", "address": "", "repoPath": remainder.strip()})
        elif mode == "ssh":
            address, _, repo_path = remainder.partition(":")
            if address.strip():
                targets.append({"name": name.strip(), "mode": "ssh", "address": address.strip(), "repoPath": repo_path.strip()})
    return [target for target in targets if target["name"]]


def probe_script(repo_path):
    repo = shlex.quote(repo_path)
    return f"""set +e
kv() {{ printf '%s=%s\\n' "$1" "$2"; }}
kv hostname "$(hostname 2>/dev/null)"
kv checked_at "$(date +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)"
kv uptime "$(uptime -p 2>/dev/null)"
kv reboot_required "$([ -f /var/run/reboot-required ] && echo yes || echo no)"
kv disk_root "$(df -h / 2>/dev/null | awk 'NR==2{{print $5 " used, " $4 " free"}}')"
kv memory "$(free -m 2>/dev/null | awk '/^Mem:/{{print $3 "MiB/" $2 "MiB"}}')"
if command -v apt >/dev/null 2>&1; then
  kv os_updates "$(apt list --upgradable 2>/dev/null | awk 'NR>1{{c++}} END{{print c+0}}')"
  kv docker_package_updates "$(apt list --upgradable 2>/dev/null | awk -F/ '/^(docker|docker-ce|docker.io|containerd|containerd.io|docker-compose-plugin)\\//{{c++}} END{{print c+0}}')"
else
  kv os_updates unknown
  kv docker_package_updates unknown
fi
if command -v docker >/dev/null 2>&1; then
  kv docker_engine "$(docker --version 2>/dev/null | sed 's/, build.*//')"
  kv docker_compose "$(docker compose version --short 2>/dev/null || echo unavailable)"
  kv docker_running "$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')"
  kv docker_unhealthy "$(docker ps --filter health=unhealthy -q 2>/dev/null | wc -l | tr -d ' ')"
  kv docker_exited "$(docker ps -a --filter status=exited -q 2>/dev/null | wc -l | tr -d ' ')"
else
  kv docker_engine unavailable
  kv docker_compose unavailable
  kv docker_running unknown
  kv docker_unhealthy unknown
  kv docker_exited unknown
fi
repo={repo}
if [ -n "$repo" ] && [ -d "$repo/.git" ]; then
  kv repo "$(git -C "$repo" status -sb 2>/dev/null | head -n 1)"
  kv repo_dirty "$(git -C "$repo" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
else
  kv repo not-configured
  kv repo_dirty unknown
fi
openclaw_config="/srv/kaosgdd/kaosai/openclaw/openclaw.json"
if [ -f "$openclaw_config" ]; then
  kv openclaw_configured yes
  kv openclaw_gateway "$(systemctl --user is-active openclaw-gateway.service 2>/dev/null || echo unknown)"
  kv openclaw_reauth_agent "$(systemctl --user is-active kaosai-openclaw-reauth-agent.service 2>/dev/null || echo unknown)"
  if command -v python3 >/dev/null 2>&1; then
    kv openclaw_primary_model "$(python3 -c 'import json, sys; payload=json.load(open(sys.argv[1], encoding="utf-8")); print(str(payload.get("agents", dict()).get("defaults", dict()).get("model", dict()).get("primary") or "unknown"))' "$openclaw_config" 2>/dev/null || echo unknown)"
    kv openclaw_last_touched "$(python3 -c 'import json, sys; payload=json.load(open(sys.argv[1], encoding="utf-8")); print(str(payload.get("meta", dict()).get("lastTouchedAt") or payload.get("wizard", dict()).get("lastRunAt") or "unknown"))' "$openclaw_config" 2>/dev/null || echo unknown)"
  else
    kv openclaw_primary_model unknown
    kv openclaw_last_touched unknown
  fi
  kv openclaw_chatgpt_expires unknown
else
  kv openclaw_configured no
fi
kv docker_image_updates "not checked; requires explicit pull"
"""


def parse_output(output):
    facts = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if separator and key:
            facts[key] = value.strip()
    return facts


def run_target(target):
    script = probe_script(target.get("repoPath", ""))
    try:
        if target["mode"] == "local":
            completed = subprocess.run(["bash", "-s"], input=script, capture_output=True, text=True, timeout=timeout)
        elif target["mode"] == "ssh":
            completed = subprocess.run(
                [
                    "ssh",
                    "-o",
                    "BatchMode=yes",
                    "-o",
                    "ConnectTimeout=5",
                    "-o",
                    "StrictHostKeyChecking=accept-new",
                    target["address"],
                    "bash -s",
                ],
                input=script,
                capture_output=True,
                text=True,
                timeout=timeout,
            )
        else:
            completed = subprocess.CompletedProcess([], 2, "", f"unsupported mode: {target['mode']}")
    except (OSError, subprocess.SubprocessError) as exc:
        return {"target": target, "ok": False, "facts": {}, "error": str(exc)[:200]}
    if completed.returncode:
        detail = (completed.stderr or completed.stdout or f"exit {completed.returncode}").strip()
        return {"target": target, "ok": False, "facts": {}, "error": detail[:200]}
    return {"target": target, "ok": True, "facts": parse_output(completed.stdout), "error": ""}


payload = {
    "collectedAt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "reports": [run_target(target) for target in parse_targets(raw_targets)],
}
os.makedirs(os.path.dirname(report_path), exist_ok=True)
fd, tmp_path = tempfile.mkstemp(prefix=".maintenance.", dir=os.path.dirname(report_path), text=True)
with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, ensure_ascii=False, indent=2, sort_keys=True)
    handle.write("\n")
os.chmod(tmp_path, 0o660)
os.replace(tmp_path, report_path)
print(report_path)
PY
  info "Maintenance report written: ${report_path}"
}

backends_preflight() {
  load_env
  require_command sqlite3
  local root=${KAOS_ROOT:-/srv/kaos}
  [[ -f "${root}/data/memos/memos_prod.db" ]] || die "Memos data is not staged at ${root}/data/memos"
  [[ "$(sqlite3 "${root}/data/memos/memos_prod.db" 'PRAGMA integrity_check;')" == "ok" ]] \
    || die "Memos SQLite integrity check failed"
  [[ -f "${root}/config/radicale/config" ]] || die "Radicale config is not staged"
  [[ -f "${root}/config/radicale/users" ]] || die "Radicale users file is not staged"
  [[ -d "${root}/data/radicale/collections" ]] || die "Radicale collections are not staged"
  "${BACKENDS_COMPOSE[@]}" config --quiet
  info "Stateful backend preflight passed."
}

services_preflight() {
  load_env
  local root=${KAOS_ROOT:-/srv/kaos}
  family_portal_source_preflight
  require_sqlite_ok "${root}/data/memos/memos_prod.db"
  require_file "${root}/config/radicale/config"
  require_file "${root}/config/radicale/users"
  require_dir "${root}/data/radicale/collections"
  require_sqlite_ok "${root}/data/vaultwarden/db.sqlite3"
  require_nonempty_file "${root}/secrets/vaultwarden.env"
  require_sqlite_ok "${root}/data/sftpgo/state/sftpgo.db"
  require_dir "${root}/data/sftpgo/config"
  require_dir "${root}/data/sftpgo/data"
  require_dir "${root}/data/sftpgo/backups"
  require_nonempty_file "${root}/data/sftpgo/state/id_ed25519"
  require_file "${root}/config/family-portal/nginx.conf"
  require_dir "${root}/data/family-portal"
  require_file "${root}/data/family-portal/index.html"
  if grep -q 'kaosgdd-gov' "${root}/config/family-portal/nginx.conf"; then
    die "family portal still references retired kaosgdd-gov upstream"
  fi
  if grep -Eq 'proxy_set_header[[:space:]]+(Host|X-Forwarded-Host)[[:space:]]+kaosgdd\.net' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must preserve request host for calendar adapter profile routing"
  fi
  if grep -Eq 'proxy_pass[[:space:]]+http://[^;]*/?api/supplies|proxy_pass[[:space:]]+http://kaosgovernor-legacy-api' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must not proxy retired supplies or legacy API routes"
  fi
  if ! grep -q 'location \^~ /api/supplies' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must route the governed Supplies API explicitly"
  fi
  if ! grep -A8 'location \^~ /api/supplies' "${root}/config/family-portal/nginx.conf" | grep -q 'proxy_pass http://governor-api:8096;'; then
    die "family portal must route /api/supplies to governor-api"
  fi
  if ! grep -q 'location \^~ /embed/agenda-supplies' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must explicitly close retired /embed/agenda-supplies"
  fi
  if ! grep -q 'location \^~ /api/paperless/' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must route the scoped Paperless API explicitly"
  fi
  if ! grep -q 'location \^~ /api/mail/' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must route the scoped Mail API explicitly"
  fi
  if ! grep -q 'location \^~ /api/system/' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must route the read-only System API explicitly"
  fi
  if ! grep -q 'location = /api/settings/status' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must route the read-only Settings status API explicitly"
  fi
  "${SERVICES_COMPOSE[@]}" config --quiet
  info "Migrated service preflight passed."
}

family_portal_source_preflight() {
  local app_source=${FAMILY_PORTAL_APP_SOURCE:-${REPO_ROOT}/apps/family-portal}
  local nginx_source=${FAMILY_PORTAL_NGINX_SOURCE:-${DEPLOY_DIR}/family-portal/nginx.conf}
  require_dir "${app_source}"
  require_file "${app_source}/index.html"
  require_file "${app_source}/app.js"
  require_file "${app_source}/deep-links.js"
  require_file "${app_source}/documents.js"
  require_file "${app_source}/fax.js"
  require_file "${app_source}/navigation.js"
  require_file "${app_source}/translations.js"
  if [ -d "${app_source}/app" ]; then
    fail "Family portal source must not contain a nested app/ duplicate"
  fi
  require_file "${nginx_source}"
  if grep -q 'kaosgdd-gov' "${nginx_source}"; then
    die "family portal source still references retired kaosgdd-gov upstream"
  fi
  if grep -Eq 'proxy_set_header[[:space:]]+(Host|X-Forwarded-Host)[[:space:]]+kaosgdd\.net' "${nginx_source}"; then
    die "family portal source must preserve request host for calendar adapter profile routing"
  fi
  if grep -Eq 'proxy_pass[[:space:]]+http://[^;]*/?api/supplies|proxy_pass[[:space:]]+http://kaosgovernor-legacy-api' "${nginx_source}"; then
    die "family portal source must not proxy retired supplies or legacy API routes"
  fi
  if ! grep -q 'location \^~ /api/supplies' "${nginx_source}"; then
    die "family portal source must route the governed Supplies API explicitly"
  fi
  if ! grep -A8 'location \^~ /api/supplies' "${nginx_source}" | grep -q 'proxy_pass http://governor-api:8096;'; then
    die "family portal source must route /api/supplies to governor-api"
  fi
  if ! grep -q 'location \^~ /embed/agenda-supplies' "${nginx_source}"; then
    die "family portal source must explicitly close retired /embed/agenda-supplies"
  fi
  if ! grep -q 'location \^~ /api/paperless/' "${nginx_source}"; then
    die "family portal source must route the scoped Paperless API explicitly"
  fi
  if ! grep -q 'location \^~ /api/fax/' "${nginx_source}"; then
    die "family portal source must route the scoped Fax API explicitly"
  fi
  if ! grep -q 'location \^~ /api/mail/' "${nginx_source}"; then
    die "family portal source must route the scoped Mail API explicitly"
  fi
  if ! grep -q 'location \^~ /api/system/' "${nginx_source}"; then
    die "family portal source must route the read-only System API explicitly"
  fi
  if ! grep -q 'location = /api/settings/status' "${nginx_source}"; then
    die "family portal source must route the read-only Settings status API explicitly"
  fi
}

family_portal_sync() {
  load_env
  require_command rsync
  require_command docker
  family_portal_source_preflight
  local root=${KAOS_ROOT:-/srv/kaos}
  local app_source=${FAMILY_PORTAL_APP_SOURCE:-${REPO_ROOT}/apps/family-portal}
  local nginx_source=${FAMILY_PORTAL_NGINX_SOURCE:-${DEPLOY_DIR}/family-portal/nginx.conf}
  install -d -m 0755 "${root}/data/family-portal" "${root}/config/family-portal"
  rsync -a --delete --exclude '*.bak-*' "${app_source}/" "${root}/data/family-portal/"
  install -m 0644 "${nginx_source}" "${root}/config/family-portal/nginx.conf"
  if docker ps --format '{{.Names}}' | grep -qx 'family-portal'; then
    "${SERVICES_COMPOSE[@]}" up --detach --no-deps --force-recreate family-portal
    docker exec family-portal nginx -t
  fi
  services_preflight
  info "Family portal synced from repository source."
}

family_transition_preflight() {
  load_env
  local root=${KAOS_ROOT:-/srv/kaos}
  local governor_state_root=${GOVERNOR_STATE_ROOT:-/srv/kaosgdd/kaosgovernor}
  local calendar_adapter_root=${CALENDAR_ADAPTER_APP_ROOT:-${REPO_ROOT}/apps/calendar-adapter}
  require_nonempty_file "${root}/secrets/governor-postgres.env"
  require_nonempty_file "${root}/secrets/governor-api.env"
  require_nonempty_file "${root}/secrets/kaosgdd-adapters.env"
  require_secret paperless_api_token
  require_dir "${governor_state_root}/postgres"
  require_file "${governor_state_root}/postgres/PG_VERSION"
  require_dir "${calendar_adapter_root}"
  require_file "${calendar_adapter_root}/server.py"
  mkdir -p "${root}/data/calendar-adapter-state"
  COMPOSE_PROFILES=family-transition "${SERVICES_COMPOSE[@]}" config --quiet
  info "Family transition preflight passed."
}

edge_preflight() {
  load_env
  local root=${KAOS_ROOT:-/srv/kaos}
  require_file "${root}/config/Caddyfile"
  require_dir "${root}/data/caddy/data"
  require_dir "${root}/data/caddy/config"
  require_nonempty_file "${root}/secrets/cloudflared.env"
  if grep -q 'kaosgdd-gov' "${root}/config/Caddyfile"; then
    die "edge config still references retired kaosgdd-gov upstream"
  fi
  if grep -Eq 'reverse_proxy[[:space:]]+[^[:space:]]*8008|KAOSSUPPLIES|supplies\.kaosgdd\.net.*reverse_proxy' "${root}/config/Caddyfile"; then
    die "edge config must not proxy retired supplies web routes"
  fi
  if grep -Eq 'path[[:space:]].*/api/supplies' "${root}/config/Caddyfile"; then
    die "edge config must not intercept governed /api/supplies routes"
  fi
  if ! grep -Eq 'reverse_proxy[[:space:]]+personal-memos-web:80' "${root}/config/Caddyfile"; then
    die "edge config must route personal Memos to the local Kaos client"
  fi
  if awk '
    /handle[[:space:]]+@(kaosgdd_documents_api|kaosgdd_hwp_handoff_api|kaosgdd_mail_organizer_api|kaosgdd_rhwp|hwp)[[:space:]]*\{/ { block = 1 }
    block && /reverse_proxy/ { bad = 1 }
    block && /^	}/ { block = 0 }
    END { exit bad ? 0 : 1 }
  ' "${root}/config/Caddyfile"; then
    die "edge config must not proxy retired portal documents, HWP, or mail-organizer routes"
  fi
  "${EDGE_COMPOSE[@]}" config --quiet
  info "Edge preflight passed."
}

usage() {
  cat <<'EOF'
Usage: deploy/h3-backend/kaos-h3 COMMAND

Commands:
  setup              Create local env, secrets, and Governor state directories
  preflight          Validate configuration without starting containers
  test               Build and run the complete container test suite
  build              Build the production Governor and worker images
  up                 Validate, build, start Governor/worker, and check health
  down               Stop Governor without deleting persistent data
  restart            Recreate Governor from current configuration
  status             Show Compose and health status
  logs               Follow Governor logs
  smoke              Check local/Tailscale health and Discord readiness
  maintenance-report Write a read-only host maintenance JSON report for Discord
  config             Render the effective Compose configuration
  backends-preflight Validate staged Memos and Radicale data for cutover
  backends-up         Start migrated Memos and Radicale after guarded preflight
  backends-down       Stop Memos and Radicale without deleting their data
  services-preflight Validate staged Radicale, Memos, Vaultwarden, SFTPGo, and family portal data
  family-portal-sync
                      Sync repository Family portal assets/config to the live H3 service path
  services-config    Render migrated service Compose configuration
  services-up        Start migrated non-edge services after guarded preflight
  services-down      Stop migrated non-edge services without deleting data
  family-preflight   Validate family API transition services
  family-up          Start family API transition services after guarded preflight
  family-down        Stop family API transition services without deleting data
  edge-preflight     Validate staged Caddy/cloudflared config and secrets
  edge-config        Render edge Compose configuration
  edge-up            Start Caddy/cloudflared after guarded preflight
  edge-down          Stop Caddy/cloudflared without deleting data
EOF
}

command=${1:-help}
case "${command}" in
  setup) setup ;;
  preflight) preflight ;;
  test) test_image ;;
  build) load_env; "${COMPOSE[@]}" build governor-discord governor-worker ;;
  up) preflight; up_runtime false; smoke ;;
  down) load_env; "${COMPOSE[@]}" down ;;
  restart) preflight; up_runtime true; smoke ;;
  status) load_env; "${COMPOSE[@]}" ps; smoke ;;
  logs) load_env; "${COMPOSE[@]}" logs --follow --tail=100 governor-discord ;;
  smoke) smoke ;;
  maintenance-report) maintenance_report ;;
  config) load_env; "${COMPOSE[@]}" config | redact_config ;;
  backends-preflight) backends_preflight ;;
  backends-up) backends_preflight; "${BACKENDS_COMPOSE[@]}" up --detach memos radicale ;;
  backends-down) load_env; "${BACKENDS_COMPOSE[@]}" stop memos radicale ;;
  services-preflight) services_preflight ;;
  family-portal-sync) family_portal_sync ;;
  services-config) load_env; "${SERVICES_COMPOSE[@]}" config | redact_config ;;
  services-up) services_preflight; "${SERVICES_COMPOSE[@]}" up --detach memos radicale vaultwarden sftpgo family-portal ;;
  services-down) load_env; "${SERVICES_COMPOSE[@]}" stop memos radicale vaultwarden sftpgo family-portal ;;
  family-preflight) family_transition_preflight ;;
  family-up) family_transition_preflight; COMPOSE_PROFILES=family-transition "${SERVICES_COMPOSE[@]}" up --detach --build governor-postgres governor-api calendar-adapter family-memos-web personal-memos-web ;;
  family-down) load_env; COMPOSE_PROFILES=family-transition "${SERVICES_COMPOSE[@]}" stop governor-api family-memos-web personal-memos-web calendar-adapter governor-postgres ;;
  edge-preflight) edge_preflight ;;
  edge-config) load_env; "${EDGE_COMPOSE[@]}" config | redact_config ;;
  edge-up) edge_preflight; "${EDGE_COMPOSE[@]}" up --detach caddy cloudflared ;;
  edge-down) load_env; "${EDGE_COMPOSE[@]}" stop cloudflared caddy ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: ${command}" ;;
esac
