#!/usr/bin/env bash
set -euo pipefail

DEPLOY_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "${DEPLOY_DIR}/../.." && pwd)
ENV_FILE="${DEPLOY_DIR}/.env"
SECRETS_DIR="${DEPLOY_DIR}/secrets"
COMPOSE=(docker compose --project-directory "${DEPLOY_DIR}" --env-file "${ENV_FILE}" -f "${DEPLOY_DIR}/compose.yaml")
BACKENDS_COMPOSE=("${COMPOSE[@]}" -f "${DEPLOY_DIR}/compose.backends.yaml")
SERVICES_COMPOSE=("${COMPOSE[@]}" -f "${DEPLOY_DIR}/compose.services.yaml")
EDGE_COMPOSE=("${COMPOSE[@]}" -f "${DEPLOY_DIR}/compose.edge.yaml")

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

load_env() {
  [[ -f "${ENV_FILE}" ]] || die "run: ${0} setup"
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
}

secret_path() {
  printf '%s/%s' "${SECRETS_DIR}" "$1"
}

require_secret() {
  local name=$1
  [[ -s "$(secret_path "${name}")" ]] || die "missing secret: ${SECRETS_DIR}/${name}"
}

sudo_test_path() {
  local predicate=$1
  local path=$2
  command -v sudo >/dev/null 2>&1 && sudo -n test "${predicate}" "${path}" 2>/dev/null
}

require_path() {
  local path=$1
  [[ -e "${path}" ]] || sudo_test_path -e "${path}" || die "missing required path: ${path}"
}

require_file() {
  local path=$1
  [[ -f "${path}" ]] || sudo_test_path -f "${path}" || die "missing required file: ${path}"
}

require_nonempty_file() {
  local path=$1
  [[ -s "${path}" ]] || sudo_test_path -s "${path}" || die "missing or empty required file: ${path}"
}

require_dir() {
  local path=$1
  [[ -d "${path}" ]] || sudo_test_path -d "${path}" || die "missing required directory: ${path}"
}

require_sqlite_ok() {
  local path=$1
  require_command sqlite3
  require_file "${path}"
  [[ "$(sqlite3 "${path}" 'PRAGMA integrity_check;')" == "ok" ]] \
    || die "SQLite integrity check failed: ${path}"
}

redact_config() {
  awk '
    BEGIN { IGNORECASE = 1 }
    /^[[:space:]]+[A-Z0-9_]*(TOKEN|PASSWORD|SECRET|KEY|AUD|CREDENTIAL|COOKIE|SALT|ENCRYPTION)[A-Z0-9_]*:/ {
      sub(/:.*/, ": [redacted]")
    }
    /^[[:space:]]+- [A-Z0-9_]*(TOKEN|PASSWORD|SECRET|KEY|AUD|CREDENTIAL|COOKIE|SALT|ENCRYPTION)[A-Z0-9_]*=/ {
      sub(/=.*/, "=[redacted]")
    }
    { print }
  '
}

install_state_directories() {
  local root=$1
  local uid gid
  uid=$(id -u)
  gid=$(id -g)
  if mkdir -p \
    "${root}/mail" \
    "${root}/fax" \
    "${root}/discord-calendar" \
    "${root}/discord-tasks" \
    "${root}/discord-supplies" \
    "${root}/discord-inbox" \
    "${root}/discord-system" 2>/dev/null; then
    chmod 0770 \
      "${root}/mail" \
      "${root}/fax" \
      "${root}/discord-calendar" \
      "${root}/discord-tasks" \
      "${root}/discord-supplies" \
      "${root}/discord-inbox" \
      "${root}/discord-system"
    return
  fi
  require_command sudo
  sudo install -d -m 0770 -o "${uid}" -g "${gid}" \
    "${root}/mail" \
    "${root}/fax" \
    "${root}/discord-calendar" \
    "${root}/discord-tasks" \
    "${root}/discord-supplies" \
    "${root}/discord-inbox" \
    "${root}/discord-system"
}

governor_state_root() {
  if [[ -n "${GOVERNOR_STATE_ROOT:-}" ]]; then
    printf '%s' "${GOVERNOR_STATE_ROOT}"
    return
  fi
  printf '%s/data/kaosgdd-ai/governor' "${KAOS_ROOT:-/srv/kaos}"
}

setup() {
  require_command docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  require_command openssl
  mkdir -p "${SECRETS_DIR}"
  if [[ ! -f "${ENV_FILE}" ]]; then
    cp "${DEPLOY_DIR}/.env.example" "${ENV_FILE}"
    sed -i "s/^KAOS_HOST_GID=.*/KAOS_HOST_GID=$(id -g)/" "${ENV_FILE}"
    info "Created ${ENV_FILE}"
  fi
  load_env
  install_state_directories "$(governor_state_root)"
  for secret in discord_bot_token memos_access_token naver_mail_password paperless_api_token fax_connector_token; do
    [[ -e "$(secret_path "${secret}")" ]] || : > "$(secret_path "${secret}")"
  done
  if [[ ! -s "$(secret_path governor_api_token)" ]]; then
    openssl rand -hex 32 > "$(secret_path governor_api_token)"
  fi
  chmod 0640 "${SECRETS_DIR}"/discord_bot_token \
    "${SECRETS_DIR}"/governor_api_token \
    "${SECRETS_DIR}"/memos_access_token \
    "${SECRETS_DIR}"/naver_mail_password \
    "${SECRETS_DIR}"/paperless_api_token \
    "${SECRETS_DIR}"/fax_connector_token
  info "Setup complete. Fill ${ENV_FILE} and ${SECRETS_DIR}/discord_bot_token, then run:"
  info "  ${0} test"
  info "  ${0} up"
}

preflight() {
  require_command docker
  require_command curl
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  load_env
  require_secret discord_bot_token
  require_secret governor_api_token
  [[ "${DISCORD_GUILD_ID:-}" != "123456789012345678" ]] || die "replace the example Discord guild ID"
  [[ "${DISCORD_ALLOWED_USER_IDS:-}" != *"123456789012345678"* ]] || die "replace the example Discord user ID"
  [[ "${DISCORD_ALLOWED_CHANNEL_IDS:-}" != *"123456789012345678"* ]] || die "replace the example Discord channel IDs"
  if [[ "${MEMOS_SEARCH_ENABLED:-false}" == "true" ]]; then
    require_secret memos_access_token
    [[ -n "${MEMOS_BASE_URL:-}" ]] || die "MEMOS_BASE_URL is required"
    [[ "${MEMOS_CREATOR:-}" == users/* ]] || die "MEMOS_CREATOR must use users/<username>"
  fi
  if [[ "${MAIL_NAVER_ENABLED:-false}" == "true" || "${MAIL_ORGANIZER_ENABLED:-false}" == "true" ]]; then
    require_secret naver_mail_password
    [[ -n "${MAIL_NAVER_USERNAME:-}" ]] || die "MAIL_NAVER_USERNAME is required"
    [[ -n "${MAIL_ARCHIVE_DISCORD_CHANNEL_ID:-}" ]] || die "MAIL_ARCHIVE_DISCORD_CHANNEL_ID is required"
  fi
  if [[ "${MAIL_ORGANIZER_ENABLED:-false}" == "true" ]]; then
    [[ -n "${MAIL_ORGANIZER_DISCORD_CHANNEL_ID:-}" ]] || die "MAIL_ORGANIZER_DISCORD_CHANNEL_ID is required"
  fi
  if [[ "${DISCORD_CALENDAR_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_CALENDAR_CHANNEL_ID:-}" ]] || die "DISCORD_CALENDAR_CHANNEL_ID is required"
    [[ -n "${CALENDAR_ADAPTER_INTERNAL_URL:-}" ]] || die "CALENDAR_ADAPTER_INTERNAL_URL is required"
  fi
  if [[ "${DISCORD_TASKS_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_TASKS_CHANNEL_ID:-}" ]] || die "DISCORD_TASKS_CHANNEL_ID is required"
    [[ -n "${CALENDAR_ADAPTER_INTERNAL_URL:-}" ]] || die "CALENDAR_ADAPTER_INTERNAL_URL is required"
  fi
  if [[ "${DISCORD_SUPPLIES_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_SUPPLIES_CHANNEL_ID:-}" ]] || die "DISCORD_SUPPLIES_CHANNEL_ID is required"
    [[ -n "${CALENDAR_ADAPTER_INTERNAL_URL:-}" ]] || die "CALENDAR_ADAPTER_INTERNAL_URL is required"
  fi
  if [[ "${DISCORD_INBOX_ENABLED:-false}" == "true" ]]; then
    [[ -n "${DISCORD_INBOX_CHANNEL_ID:-}" ]] || die "DISCORD_INBOX_CHANNEL_ID is required"
    [[ -n "${PAPERLESS_BASE_URL:-${PAPERLESS_INTERNAL_URL:-}}" ]] || die "PAPERLESS_BASE_URL is required"
    require_secret paperless_api_token
  fi
  if [[ "${FAX_DISCORD_ENABLED:-false}" == "true" ]]; then
    [[ "${FAX_TRANSPORT:-connector}" == "connector" ]] \
      || die "H3 fax must use FAX_TRANSPORT=connector; HylaFAX stays on Office Kaos"
    [[ -n "${FAX_CONNECTOR_BASE_URL:-}" ]] || die "FAX_CONNECTOR_BASE_URL is required when fax is enabled"
    require_secret fax_connector_token
  fi
  "${COMPOSE[@]}" config --quiet
  info "Preflight passed."
}

test_image() {
  require_command docker
  docker build --target test \
    --tag kaosgdd-ai-governor-discord:test \
    --file "${REPO_ROOT}/integrations/discord/Dockerfile" \
    "${REPO_ROOT}"
  docker run --rm kaosgdd-ai-governor-discord:test
}

smoke() {
  load_env
  local address=${GOVERNOR_BIND_ADDRESS:-127.0.0.1}
  [[ "${address}" != "0.0.0.0" ]] || address=127.0.0.1
  local url="http://${address}:${HEALTH_PORT:-8097}/health"
  local attempt
  for attempt in $(seq 1 30); do
    if curl --fail --silent --show-error "${url}" >/dev/null 2>&1; then
      curl --fail --silent --show-error "${url}"
      printf '\n'
      return
    fi
    sleep 1
  done
  "${COMPOSE[@]}" logs --tail=80 governor-discord >&2 || true
  die "Governor health endpoint did not become available: ${url}"
}

backends_preflight() {
  load_env
  require_command sqlite3
  local root=${KAOS_ROOT:-/srv/kaos}
  [[ -f "${root}/data/memos/memos_prod.db" ]] || die "Memos data is not staged at ${root}/data/memos"
  [[ "$(sqlite3 "${root}/data/memos/memos_prod.db" 'PRAGMA integrity_check;')" == "ok" ]] \
    || die "Memos SQLite integrity check failed"
  [[ -f "${root}/config/radicale/config" ]] || die "Radicale config is not staged"
  [[ -f "${root}/config/radicale/users" ]] || die "Radicale users file is not staged"
  [[ -d "${root}/data/radicale/collections" ]] || die "Radicale collections are not staged"
  "${BACKENDS_COMPOSE[@]}" config --quiet
  info "Stateful backend preflight passed."
}

services_preflight() {
  load_env
  local root=${KAOS_ROOT:-/srv/kaos}
  require_sqlite_ok "${root}/data/memos/memos_prod.db"
  require_file "${root}/config/radicale/config"
  require_file "${root}/config/radicale/users"
  require_dir "${root}/data/radicale/collections"
  require_sqlite_ok "${root}/data/vaultwarden/db.sqlite3"
  require_nonempty_file "${root}/secrets/vaultwarden.env"
  require_sqlite_ok "${root}/data/sftpgo/state/sftpgo.db"
  require_dir "${root}/data/sftpgo/config"
  require_dir "${root}/data/sftpgo/data"
  require_dir "${root}/data/sftpgo/backups"
  require_nonempty_file "${root}/data/sftpgo/state/id_ed25519"
  require_file "${root}/config/family-portal/nginx.conf"
  require_dir "${root}/data/family-portal"
  require_file "${root}/data/family-portal/index.html"
  if grep -q 'kaosgdd-gov' "${root}/config/family-portal/nginx.conf"; then
    die "family portal still references retired kaosgdd-gov upstream"
  fi
  if grep -Eq 'proxy_pass[[:space:]]+http://[^;]*/?api/supplies|proxy_pass[[:space:]]+http://kaosgovernor-legacy-api' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must not proxy supplies API routes"
  fi
  if ! grep -q 'location \^~ /api/supplies' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must explicitly close /api/supplies"
  fi
  if ! grep -q 'location \^~ /embed/agenda-supplies' "${root}/config/family-portal/nginx.conf"; then
    die "family portal must explicitly close retired /embed/agenda-supplies"
  fi
  "${SERVICES_COMPOSE[@]}" config --quiet
  info "Migrated service preflight passed."
}

family_transition_preflight() {
  load_env
  local root=${KAOS_ROOT:-/srv/kaos}
  require_nonempty_file "${root}/secrets/kaosgovernor-legacy-database.env"
  require_nonempty_file "${root}/secrets/kaosgovernor-legacy-api.env"
  require_nonempty_file "${root}/secrets/kaosgdd-adapters.env"
  require_dir "${root}/data/kaosgdd-gov/postgres"
  require_file "${root}/data/kaosgdd-gov/postgres/PG_VERSION"
  require_dir "${root}/data/calendar-adapter"
  require_file "${root}/data/calendar-adapter/server.py"
  COMPOSE_PROFILES=family-transition "${SERVICES_COMPOSE[@]}" config --quiet
  info "Family transition preflight passed."
}

edge_preflight() {
  load_env
  local root=${KAOS_ROOT:-/srv/kaos}
  require_file "${root}/config/Caddyfile"
  require_dir "${root}/data/caddy/data"
  require_dir "${root}/data/caddy/config"
  require_nonempty_file "${root}/secrets/cloudflared.env"
  "${EDGE_COMPOSE[@]}" config --quiet
  info "Edge preflight passed."
}

usage() {
  cat <<'EOF'
Usage: deploy/h3-backend/kaos-h3 COMMAND

Commands:
  setup              Create local env, secrets, and Governor state directories
  preflight          Validate configuration without starting containers
  test               Build and run the complete container test suite
  build              Build the production Governor image
  up                 Validate, build, start Governor, and check health
  down               Stop Governor without deleting persistent data
  restart            Recreate Governor from current configuration
  status             Show Compose and health status
  logs               Follow Governor logs
  smoke              Check the local/Tailscale health endpoint
  config             Render the effective Compose configuration
  backends-preflight Validate staged Memos and Radicale data for cutover
  backends-up         Start migrated Memos and Radicale after guarded preflight
  backends-down       Stop Memos and Radicale without deleting their data
  services-preflight Validate staged Radicale, Memos, Vaultwarden, SFTPGo, and family portal data
  services-config    Render migrated service Compose configuration
  services-up        Start migrated non-edge services after guarded preflight
  services-down      Stop migrated non-edge services without deleting data
  family-preflight   Validate transitional family API services when still needed
  family-up          Start transitional family API services after guarded preflight
  family-down        Stop transitional family API services without deleting data
  edge-preflight     Validate staged Caddy/cloudflared config and secrets
  edge-config        Render edge Compose configuration
  edge-up            Start Caddy/cloudflared after guarded preflight
  edge-down          Stop Caddy/cloudflared without deleting data
EOF
}

command=${1:-help}
case "${command}" in
  setup) setup ;;
  preflight) preflight ;;
  test) test_image ;;
  build) load_env; "${COMPOSE[@]}" build governor-discord ;;
  up) preflight; "${COMPOSE[@]}" up --detach --build governor-discord; smoke ;;
  down) load_env; "${COMPOSE[@]}" down ;;
  restart) preflight; "${COMPOSE[@]}" up --detach --build --force-recreate governor-discord; smoke ;;
  status) load_env; "${COMPOSE[@]}" ps; smoke ;;
  logs) load_env; "${COMPOSE[@]}" logs --follow --tail=100 governor-discord ;;
  smoke) smoke ;;
  config) load_env; "${COMPOSE[@]}" config | redact_config ;;
  backends-preflight) backends_preflight ;;
  backends-up) backends_preflight; "${BACKENDS_COMPOSE[@]}" up --detach memos radicale ;;
  backends-down) load_env; "${BACKENDS_COMPOSE[@]}" stop memos radicale ;;
  services-preflight) services_preflight ;;
  services-config) load_env; "${SERVICES_COMPOSE[@]}" config | redact_config ;;
  services-up) services_preflight; "${SERVICES_COMPOSE[@]}" up --detach memos radicale vaultwarden sftpgo family-portal ;;
  services-down) load_env; "${SERVICES_COMPOSE[@]}" stop memos radicale vaultwarden sftpgo family-portal ;;
  family-preflight) family_transition_preflight ;;
  family-up) family_transition_preflight; COMPOSE_PROFILES=family-transition "${SERVICES_COMPOSE[@]}" up --detach kaosgovernor-legacy-database calendar-adapter kaosgovernor-legacy-api family-memos-web ;;
  family-down) load_env; COMPOSE_PROFILES=family-transition "${SERVICES_COMPOSE[@]}" stop kaosgovernor-legacy-api family-memos-web calendar-adapter kaosgovernor-legacy-database ;;
  edge-preflight) edge_preflight ;;
  edge-config) load_env; "${EDGE_COMPOSE[@]}" config | redact_config ;;
  edge-up) edge_preflight; "${EDGE_COMPOSE[@]}" up --detach caddy cloudflared ;;
  edge-down) load_env; "${EDGE_COMPOSE[@]}" stop cloudflared caddy ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: ${command}" ;;
esac
